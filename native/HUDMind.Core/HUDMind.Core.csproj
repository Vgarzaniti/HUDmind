<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../profiles/**/*.json" LogicalName="HUDMind.DefaultProfiles/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../profiles/**/*.md" Exclude="../../profiles/**/custom_rules.md" LogicalName="HUDMind.DefaultProfiles/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
