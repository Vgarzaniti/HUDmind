<UserControl x:Class="HUDMind.App.Controls.ActiveProfileBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource FeaturedCardPanel}" Padding="13,11">
        <StackPanel>
            <!-- Top Row: Game Identity + Context/Memory Badge -->
            <DockPanel Margin="0,0,0,10">
                <Border x:Name="ContextPillBorder"
                        DockPanel.Dock="Right"
                        Background="#052E24"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="9,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtContextStatus"
                               Text="Memoria &amp; Contexto: LISTO"
                               Foreground="#6EE7B7"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#092130"
                            BorderBrush="#22D3EE"
                            BorderThickness="1"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center">
                        <Path Data="M6,9 L10,9 L10,5 L14,5 L14,9 L18,9 L18,15 L14,15 L14,19 L10,19 L10,15 L6,15 Z"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              Fill="#22D3EE"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PERFIL DE JUEGO ACTIVO"
                                   Foreground="#22D3EE"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,1" />
                        <TextBlock x:Name="StatActiveGame"
                                   Text="Esperando juego"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtProfileMeta"
                                   Text="Auto-Detectar listo · 0% GPU pasivo"
                                   FontSize="11"
                                   Foreground="#8EA4BC"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Compact Telemetry Inset Tiles -->
            <UniformGrid Columns="3">
                <Border Background="#070C13" CornerRadius="7" Padding="10,7" Margin="0,0,8,0" BorderBrush="#142537" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LblAiCardTitle" Text="VELOCIDAD DE RESPUESTA" FontSize="9.5" Foreground="#7A92AA" FontWeight="Bold" />
                        <TextBlock x:Name="StatAiMs" Text="—" FontSize="15.5" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#070C13" CornerRadius="7" Padding="10,7" Margin="0,0,8,0" BorderBrush="#142537" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LblVoiceCardTitle" Text="VOZ Y MICRÓFONO" FontSize="9.5" Foreground="#7A92AA" FontWeight="Bold" />
                        <TextBlock x:Name="StatVoiceMs" Text="Listo" FontSize="15.5" FontWeight="Bold" Foreground="#22D3EE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#070C13" CornerRadius="7" Padding="10,7" BorderBrush="#142537" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CONSEJOS EN PARTIDA" FontSize="9.5" Foreground="#7A92AA" FontWeight="Bold" />
                        <TextBlock x:Name="StatInterventions" Text="0" FontSize="15.5" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
