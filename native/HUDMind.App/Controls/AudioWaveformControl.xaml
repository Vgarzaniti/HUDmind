<UserControl x:Class="HUDMind.App.Controls.AudioWaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Border x:Name="WaveFrame"
            Background="#05090F"
            BorderBrush="#142638"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,5">
        <Viewbox Stretch="Uniform" MaxHeight="34">
            <StackPanel x:Name="BarsHost"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Height="32" />
        </Viewbox>
    </Border>
</UserControl>
