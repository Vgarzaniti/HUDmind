<Window x:Class="HUDMind.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440">
    <Border x:Name="CardBorder"
            CornerRadius="12"
            Background="#E60F172A"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            Padding="14,10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="UrgencyBar" Grid.Column="0" CornerRadius="3" Background="#38BDF8" Margin="0,2,10,2" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock x:Name="TitleBlock"
                           Text="HUDMind · Coach"
                           Foreground="#94A3B8"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MessageBlock"
                           Text=""
                           Foreground="#F8FAFC"
                           FontFamily="Segoe UI"
                           FontSize="14.5"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
