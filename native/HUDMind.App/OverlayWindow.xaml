<Window x:Class="HUDMind.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440">
    <!-- Zero-GPU flat crisp double-border glass card (no DropShadowEffect shader overhead!) -->
    <Border CornerRadius="13" Background="#66020617" Padding="2" Margin="4">
        <Border x:Name="CardBorder"
                CornerRadius="11"
                Background="#EB0F172A"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="UrgencyBar" Grid.Column="0" Width="5" CornerRadius="3" Background="#38BDF8" Margin="0,2,0,2" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="TitleBlock"
                               Text="HUDMind · Coach"
                               Foreground="#94A3B8"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="MessageBlock"
                               Text=""
                               Foreground="#F8FAFC"
                               FontFamily="Segoe UI"
                               FontSize="14.5"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
