<Window x:Class="HUDMind.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HUDMind.App.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440">
    <!-- Cyber-Tactical In-Game Overlay (0% GPU SoftwareOnly, crisp layered frame & WS_EX_TRANSPARENT) -->
    <Border x:Name="OuterShadowFrame" CornerRadius="13" Background="Transparent" Padding="0" Margin="4">
        <Border x:Name="CardBorder"
                CornerRadius="11"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="11,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card Icon Badge (shown only in full tactical 'card' style) -->
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        CornerRadius="7"
                        Background="#0A2B38"
                        BorderBrush="#22D3EE"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,1,10,0"
                        Visibility="Collapsed">
                    <Path Data="M12,2 A3,3 0 0,1 15,5 V11 A3,3 0 0,1 9,11 V5 A3,3 0 0,1 12,2 M19,11 A7,7 0 0,1 5,11 H7 A5,5 0 0,0 17,11 H19 M11,18.9 V22 H13 V18.9"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          Fill="#67E8F9"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Content Stack: Compact Header + Discord-Style Stacked Messages + Card Footer -->
                <StackPanel Grid.Column="1">
                    <DockPanel x:Name="HeaderDock" Margin="0,0,0,4">
                        <Border x:Name="StatusTagBorder"
                                DockPanel.Dock="Right"
                                Background="#0A2B33"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1.5"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <controls:OverlayTextBlock x:Name="StatusTagText"
                                                       Text="ACTIVO"
                                                       Foreground="#6EE7B7"
                                                       FontFamily="Consolas"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       TextWrapping="NoWrap" />
                        </Border>
                        <controls:OverlayTextBlock x:Name="TitleBlock"
                                                   Text="HUDMIND"
                                                   Foreground="#22D3EE"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl x:Name="FeedItemsHost" IsHitTestVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding RowOpacity}" Margin="{Binding RowMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="3"
                                            CornerRadius="1.5"
                                            Background="{Binding AccentBrush}"
                                            Margin="0,2,8,2" />

                                    <StackPanel Grid.Column="1">
                                        <controls:OverlayTextBlock Text="{Binding SpeakerLabel}"
                                                                   Visibility="{Binding SpeakerVisibility}"
                                                                   Foreground="{Binding SpeakerBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{Binding SpeakerFontSize}"
                                                                   FontWeight="Bold"
                                                                   StrongHalo="{Binding StrongHalo}"
                                                                   TextWrapping="NoWrap"
                                                                   Margin="0,0,0,1" />
                                        <controls:OverlayTextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding MessageBrush}"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="{Binding MessageFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   StrongHalo="{Binding StrongHalo}"
                                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sleek Vector Telemetry Waveform + Hotkey Chips (shown in 'card' style) -->
                    <DockPanel x:Name="FooterDock" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="HotkeyHintsPanel"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="10,0,0,0">
                            <Border x:Name="ChipPauseBorder" Background="#09131F" BorderBrush="#1B3247" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                <TextBlock x:Name="TxtPauseChip" Text="F9 PAUSA" Foreground="#94A3B8" FontFamily="Consolas" FontSize="9.5" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="ChipAnalyzeBorder" Background="#09131F" BorderBrush="#1B3247" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TxtAnalyzeChip" Text="F10 IA" Foreground="#94A3B8" FontFamily="Consolas" FontSize="9.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <controls:AudioWaveformControl x:Name="OverlayWave" ShowFrame="False" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
