<Window x:Class="HUDMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUDMind Native (.NET 9) — Real-Time eSports AI Coach"
        Icon="Assets/hudmind.ico"
        Width="990"
        Height="690"
        MinWidth="860"
        MinHeight="590"
        Background="#0B1120"
        Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Image Source="Assets/hudmind-icon.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="HUDMind" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                <Button x:Name="BtnVersionCheck"
                        Content="v1.1.0"
                        FontSize="10.5"
                        Padding="7,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        Foreground="#94A3B8"
                        ToolTip="Clic para buscar actualizaciones en GitHub Releases"
                        Click="BtnCheckUpdates_Click" />
                <Border Background="#10B981" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderBadge" Text=".NET 9 · 0% GPU · $0 COSTO · MULTI-IA" FontSize="10.5" FontWeight="Bold" Foreground="#052E16" />
                </Border>
                <Border x:Name="PauseBadge" Background="#F59E0B" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="PAUSADO" FontSize="10.5" FontWeight="Bold" Foreground="#1E1B18" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="HeaderStatusText"
                       DockPanel.Dock="Right"
                       Text="Estado: Detenido"
                       Foreground="#94A3B8"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- In-App Update Notification Banner (auto-shown when a newer GitHub Release exists) -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#0C4A6E"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                CornerRadius="9"
                Padding="12,9"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnDownloadUpdate"
                            Content="⬇ Descargar actualización"
                            Background="#059669"
                            BorderBrush="#10B981"
                            Foreground="#FFFFFF"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Click="BtnDownloadUpdate_Click" />
                    <Button x:Name="BtnLaunchUpdate"
                            Content="▶ Abrir nuevo .exe"
                            Background="#0284C7"
                            BorderBrush="#38BDF8"
                            Foreground="#FFFFFF"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnLaunchUpdate_Click" />
                    <Button x:Name="BtnOpenUpdateFolder"
                            Content="📂 Carpeta"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnOpenUpdateFolder_Click" />
                    <Button x:Name="BtnOpenReleasePage"
                            Content="🌐 Ver en GitHub"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Click="BtnOpenReleasePage_Click" />
                    <Button x:Name="BtnDismissUpdate"
                            Content="✕"
                            Padding="8,5"
                            ToolTip="Ocultar aviso (o cancelar descarga en curso)"
                            Click="BtnDismissUpdate_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUpdateBannerTitle"
                               Text="🚀 Nueva actualización disponible"
                               Foreground="#F8FAFC"
                               FontWeight="Bold"
                               FontSize="13" />
                    <TextBlock x:Name="TxtUpdateBannerDetails"
                               Text=""
                               Foreground="#BAE6FD"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Height="5"
                                 Minimum="0"
                                 Maximum="100"
                                 Margin="0,6,0,0"
                                 Background="#082F49"
                                 Foreground="#10B981"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="2">

            <!-- TAB 1: CONTROL & LIVE LATENCY -->
            <TabItem Header="⚡ Coach en Vivo">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Onboarding Quick Banner (auto-shown when no AI account configured) -->
                    <Border x:Name="OnboardingBanner" Grid.Row="0" Visibility="Collapsed" Background="#172554" CornerRadius="9" Padding="10" Margin="0,0,0,10" BorderBrush="#38BDF8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button Content="1. Ir a Cuentas IA →" Background="#0284C7" BorderBrush="#38BDF8" Padding="10,4" Margin="0,0,6,0" Click="BtnGoAccounts_Click" />
                                <Button Content="2. Audio y Overlay" Padding="10,4" Margin="0,0,6,0" Click="BtnGoSettings_Click" />
                                <Button Content="✕" Padding="8,4" ToolTip="Ocultar guía" Click="BtnDismissOnboarding_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="👋 Guía rápida en 3 pasos (0% GPU · Gratis con tu API key)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12.5" />
                                <TextBlock Text="1) Pegá una key gratis de Gemini o Groq en Cuentas IA → 2) Probá tu micrófono y overlay → 3) Elegí Charla / Solo voz / Solo texto y tocá Iniciar." Foreground="#BAE6FD" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Controls Bar -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="BtnStartStop" Content="▶ Iniciar Coach" Background="#0284C7" BorderBrush="#38BDF8" Click="BtnStartStop_Click" Margin="0,0,10,4" />
                            <Button x:Name="BtnAnalyzeNow" Content="🎯 Analizar (F10)" Click="BtnAnalyzeNow_Click" IsEnabled="False" Margin="0,0,10,4" />
                            <Button x:Name="BtnPause" Content="⏸ Pausar (F9)" Click="BtnPause_Click" IsEnabled="False" Margin="0,0,16,4" />

                            <TextBlock Text="Modo:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbRunMode" Width="168" Margin="0,0,12,4" SelectedIndex="0">
                                <ComboBoxItem Content="Auto-Detectar Juego" Tag="auto" />
                                <ComboBoxItem Content="Modo Prueba (Escritorio)" Tag="test" />
                            </ComboBox>

                            <TextBlock Text="Perfil:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbGameProfile" Width="165" Margin="0,0,12,4" />

                            <TextBlock Text="Sesión:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbCoachMode" Width="145" Margin="0,0,12,4">
                                <ComboBoxItem Content="Automático (IA)" Tag="auto" />
                                <ComboBoxItem Content="Partida Competitiva" Tag="match" />
                                <ComboBoxItem Content="Entrenamiento" Tag="training" />
                            </ComboBox>

                            <TextBlock Text="Voz:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbQuickGender" Width="118" Margin="0,0,12,4" SelectionChanged="CmbQuickGender_SelectionChanged">
                                <ComboBoxItem Content="👨 Hombre" Tag="male" />
                                <ComboBoxItem Content="👩 Mujer" Tag="female" />
                            </ComboBox>

                            <TextBlock Text="Motor:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbEngineType" Width="205" Margin="0,0,12,4">
                                <ComboBoxItem Content="🎙 Live Conversacional (~0.9s)" Tag="live" />
                                <ComboBoxItem Content="⚡ Turnos Multi-IA (Clásico)" Tag="classic" />
                            </ComboBox>

                            <TextBlock Text="Comunicación:" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,6,4" />
                            <ComboBox x:Name="CmbCommMode" Width="210" Margin="0,0,0,4" SelectionChanged="CmbCommMode_SelectionChanged">
                                <ComboBoxItem Content="🎙 Charla (Mic + Voz)" Tag="conversation" />
                                <ComboBoxItem Content="🔊 Solo voz del coach" Tag="coach_voice" />
                                <ComboBoxItem Content="💬 Solo texto (Sin voz)" Tag="text_only" />
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- Real-Time Latency Cards -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CAPTURA + dHASH + JPEG" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatCaptureMs" Text="— ms" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblAiCardTitle" Text="VISIÓN IA / RESPUESTA" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatAiMs" Text="— ms" FontSize="19" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblVoiceCardTitle" Text="VOZ DEL COACH" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatVoiceMs" Text="— ms" FontSize="19" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="INTERVENCIONES / ACTIVO" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatInterventions" Text="0" FontSize="17" FontWeight="Bold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Console Toolbar -->
                    <DockPanel Grid.Row="3" Margin="0,0,0,6">
                        <TextBlock Text="Consola en vivo (redacción automática de API keys activa)" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="🧹 Limpiar Logs" Padding="10,3" FontSize="11" Click="BtnClearLogs_Click" />
                    </DockPanel>

                    <!-- Virtualized O(1) Live Console / Chat Log -->
                    <Border Grid.Row="4" Background="#020617" CornerRadius="8" Padding="6" BorderBrush="#1E293B" BorderThickness="1">
                        <ListBox x:Name="LstLiveLogs"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CBD5E1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155">
                                    <MenuItem Header="📋 Copiar línea seleccionada" Click="MenuCopyLog_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#CBD5E1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Interactive Text Chat + Post-Match Review Bar -->
                    <Border Grid.Row="5" Background="#0F172A" CornerRadius="8" Padding="8" Margin="0,8,0,0" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💬 Chat:" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <TextBox x:Name="TxtChatInput"
                                     Grid.Column="1"
                                     Margin="0,0,8,0"
                                     IsEnabled="False"
                                     KeyDown="TxtChatInput_KeyDown"
                                     ToolTip="Escribí una pregunta o mensaje al coach (ve tu pantalla actual) · Presioná Enter para enviar" />
                            <Button x:Name="BtnSendChat"
                                    Grid.Column="2"
                                    Content="Enviar ↵"
                                    Background="#0284C7"
                                    BorderBrush="#38BDF8"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="BtnSendChat_Click" />
                            <Button x:Name="BtnMatchReview"
                                    Grid.Column="3"
                                    Content="📊 Resumen Partida"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    ToolTip="Analiza tus errores repetidos de la última sesión, guarda un Markdown en logs/reviews y te da 1 ejercicio práctico"
                                    Click="BtnMatchReview_Click" />
                            <Button x:Name="BtnOpenReviews"
                                    Grid.Column="4"
                                    Content="📂 Resúmenes"
                                    ToolTip="Abre la carpeta logs/reviews donde se guardan tus resúmenes post-partida"
                                    Click="BtnOpenReviews_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ACCOUNTS & FREE CLOUD POOL -->
            <TabItem Header="🔑 Cuentas IA ($0 Gratis)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Proper DockPanel order: Dock=Right FIRST so TextBlock fills remaining space -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#0284C7" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button Content="🌐 Key Gratis Groq (~0.4s)" Click="BtnOpenGroq_Click" Margin="0,0,6,0" />
                                <Button Content="🌐 Key Gratis Gemini" Click="BtnOpenGemini_Click" />
                            </StackPanel>
                            <TextBlock Text="⚡ Para bajar a ~0.40s reales GRATIS (0% GPU): agregá una API key gratuita de Groq (Llama-4-Scout) o Gemini."
                                       Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <ListView x:Name="LstAccounts" Grid.Row="1" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#1E293B" Margin="0,0,0,10" MouseDoubleClick="LstAccounts_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Alias" Width="185" DisplayMemberBinding="{Binding Label}" />
                                <GridViewColumn Header="Proveedor" Width="95" DisplayMemberBinding="{Binding Provider}" />
                                <GridViewColumn Header="Modelo" Width="205" DisplayMemberBinding="{Binding Model}" />
                                <GridViewColumn Header="Visión" Width="95" DisplayMemberBinding="{Binding VisionDisplay}" />
                                <GridViewColumn Header="API Key" Width="120" DisplayMemberBinding="{Binding MaskedKeyDisplay}" />
                                <GridViewColumn Header="Activo" Width="55" DisplayMemberBinding="{Binding EnabledDisplay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Stream-Safe Quick Add Form (PasswordBox hides API key on OBS/Discord!) -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbNewProvider" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="CmbNewProvider_SelectionChanged" />
                                <TextBox x:Name="TxtNewLabel" Grid.Column="1" Margin="0,0,6,0" Text="Groq LPU Gratis (~0.4s)" />
                                <TextBox x:Name="TxtNewModel" Grid.Column="2" Margin="0,0,6,0" Text="meta-llama/llama-4-scout-17b-16e-instruct" />
                                <PasswordBox x:Name="PwdNewApiKey" Grid.Column="3" Margin="0,0,6,0" ToolTip="Pegá tu API Key (oculta para seguridad en OBS/Discord)" />
                                <Button x:Name="BtnAddAccount" Grid.Column="4" Content="+ Agregar #1" Background="#059669" BorderBrush="#10B981" Click="BtnAddAccount_Click" />
                                <Button x:Name="BtnCancelEdit" Grid.Column="5" Content="Cancelar" Visibility="Collapsed" Margin="6,0,0,0" Click="BtnCancelEdit_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="185" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BaseUrl (opcional):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="TxtNewBaseUrl"
                                         Grid.Column="1"
                                         Margin="0,0,12,0"
                                         ToolTip="Opcional: endpoint HTTPS custom (o http://localhost:11434/v1 en Ollama). Dejar vacío usa la URL oficial del proveedor." />
                                <TextBlock Grid.Column="2" Text="Modo Visión:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbNewVisionOverride"
                                          Grid.Column="3"
                                          SelectedIndex="0"
                                          ToolTip="Automático deduce por nombre de modelo; Solo Texto activa modo ciego con WinRT OCR + Logs locales.">
                                    <ComboBoxItem Content="Automático" Tag="auto" />
                                    <ComboBoxItem Content="Con Visión (Imagen)" Tag="vision" />
                                    <ComboBoxItem Content="Solo Texto (OCR+Logs)" Tag="text" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="↑ Subir" Click="BtnMoveUp_Click" Margin="0,0,6,0" />
                        <Button Content="↓ Bajar" Click="BtnMoveDown_Click" Margin="0,0,6,0" />
                        <Button x:Name="BtnEditAccount" Content="✏ Editar" Click="BtnEditAccount_Click" Margin="0,0,6,0" />
                        <Button Content="Activar / Pausar" Click="BtnToggleAccount_Click" Margin="0,0,6,0" />
                        <Button x:Name="BtnTestAccount" Content="🔍 Probar Conexión" Click="BtnTestAccount_Click" Margin="0,0,6,0" />
                        <Button Content="Eliminar" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteAccount_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: CUSTOM GAME RULES -->
            <TabItem Header="🎮 Reglas por Juego">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Juego:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbRulesGame" Width="220" SelectionChanged="CmbRulesGame_SelectionChanged" />
                        <TextBlock x:Name="LblRulesCount" Text="0 / 600 caracteres (envío íntegro en tiempo real)" Foreground="#94A3B8" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="8" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="+ Nuevo Perfil" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <TextBlock Grid.Column="1" Text="ID:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtNewProfId" Grid.Column="2" Margin="0,0,10,0" ToolTip="ID corto en minúsculas y guion bajo (ej: apex_legends)" />
                            <TextBlock Grid.Column="3" Text="Nombre:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtNewProfName" Grid.Column="4" Margin="0,0,10,0" ToolTip="Nombre visible del juego (ej: Apex Legends)" />
                            <TextBlock Grid.Column="5" Text="EXE(s):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtNewProfExe" Grid.Column="6" Margin="0,0,8,0" ToolTip="Proceso(s) requeridos separados por coma (ej: r5apex.exe, r5apex_dx12.exe)" />
                            <Button x:Name="BtnCreateProfile" Grid.Column="7" Content="➕ Crear Perfil" Background="#059669" BorderBrush="#10B981" Click="BtnCreateProfile_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="8" Margin="0,0,0,8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="EXEs:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,6,0" />
                            <TextBox x:Name="TxtProfileExes" Grid.Column="1" Margin="0,0,12,0" ToolTip="Ejecutables del perfil actual separados por coma (manifest.json)" />
                            <TextBlock Grid.Column="2" Text="Cooldown (s):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtProfileCooldown" Grid.Column="3" Margin="0,0,12,0" ToolTip="Segundos entre consejos automáticos (1..120)" />
                            <TextBlock Grid.Column="4" Text="pHash:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtProfilePhash" Grid.Column="5" ToolTip="Sensibilidad de cambio visual (1..64, menor = más sensible)" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtCustomRules"
                             Grid.Row="3"
                             MaxLength="600"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12.5"
                             TextChanged="TxtCustomRules_TextChanged" />
                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button x:Name="BtnDeleteProfile" DockPanel.Dock="Left" Content="🗑 Eliminar Perfil" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteProfile_Click" />
                        <Button Content="💾 Guardar Reglas y Perfil" HorizontalAlignment="Right" Background="#0284C7" BorderBrush="#38BDF8" Click="BtnSaveRules_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: VOICE, RANK, OVERLAY & HOTKEYS -->
            <TabItem Header="⚙ Coach, Rango y Voz">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left">
                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox x:Name="ChkEnableOverlay" Content="Overlay Click-Through (0% GPU)" Foreground="#F1F5F9" Margin="0,0,18,6" />
                        <CheckBox x:Name="ChkOverlayCompact" Content="Overlay Compacto (estilo pill)" Foreground="#F1F5F9" Margin="0,0,18,6" />
                        <CheckBox x:Name="ChkEnableHotkeys" Content="Teclas Globales (Win32)" Foreground="#F1F5F9" Margin="0,0,18,6" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimizar a Bandeja del Sistema" Foreground="#38BDF8" Margin="0,0,18,6" />
                        <CheckBox x:Name="ChkEnableAudioCues" Content="Tonos sutiles (Pausa/Mic/PTT)" Foreground="#F1F5F9" Margin="0,0,18,6" ToolTip="Emite un tono suave de confirmación al pausar, alternar micrófono o pulsar Push-to-Talk (silenciado en modo Solo Texto)." />
                        <CheckBox x:Name="ChkCheckUpdatesOnStartup" Content="Buscar actualizaciones al iniciar" Foreground="#10B981" Margin="0,0,0,6" ToolTip="Consulta GitHub Releases en segundo plano al abrir HUDMind (sin descargas automáticas sin tu permiso)." />
                    </WrapPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="95" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo de Comunicación:" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbCommModeSettings" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbCommModeSettings_SelectionChanged">
                            <ComboBoxItem Content="🎙 Charla (Mic en vivo + Voz del coach)" Tag="conversation" />
                            <ComboBoxItem Content="🔊 Solo voz del coach (mic apagado, solo te habla)" Tag="coach_voice" />
                            <ComboBoxItem Content="💬 Solo texto (100% silencioso: chat + overlay)" Tag="text_only" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tu Nivel / Rango:" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbSkillTier" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="🌱 Principiante (fundamentos simples y paciencia)" Tag="beginner" />
                            <ComboBoxItem Content="🥉 Bajo / Casual (Bronce–Plata / Hierro–Bronce)" Tag="casual" />
                            <ComboBoxItem Content="🥈 Intermedio (Oro–Platino / Plata–Oro)" Tag="intermediate" />
                            <ComboBoxItem Content="🥇 Avanzado (Diamante–Campeón / Ascendente)" Tag="advanced" />
                            <ComboBoxItem Content="🏆 Competitivo / Pro (GC–SSL / Radiant / Faceit 10)" Tag="pro" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rango exacto (opcional):" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtRankLabel" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: Platino 2 en 2v2, Diamante 1, Oro 3..." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Personalidad del Coach:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbCoachStyle" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="🤝 Amigable y Llevadero (motivador, celebra aciertos)" Tag="friendly" />
                            <ComboBoxItem Content="🎯 Directo y Táctico (sereno al punto)" Tag="tactical" />
                            <ComboBoxItem Content="🔥 Exigente Estilo Pro (ritmo torneo)" Tag="strict" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ritmo Auto-Coach Live:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbLiveAutoRate" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="🎙 Solo cuando le hablo o toco F10 (cero interrupción)" Tag="0" />
                            <ComboBoxItem Content="⚖ Equilibrado (cada 12s en jugada real)" Tag="12" />
                            <ComboBoxItem Content="⚡ Activo (cada 8s en jugada real)" Tag="8" />
                        </ComboBox>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Género de Voz:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbVoiceGender" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                            <ComboBoxItem Content="👨 Hombre (Fenrir Live / Tomas / Raul)" Tag="male" />
                            <ComboBoxItem Content="👩 Mujer (Aoede Live / Elena / Sabina)" Tag="female" />
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Voz Modo Clásico:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbVoiceStyle" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                            <ComboBoxItem Content="🎙 Windows Natural / OneCore (0% Red · Tu Parlante)" Tag="neural" />
                            <ComboBoxItem Content="⚡ Instantánea SAPI/OneCore (~8ms, Tiempo Real)" Tag="instant" />
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Idioma del Coach:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbLanguage" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="es" />
                            <ComboBoxItem Content="en" />
                        </ComboBox>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Perfil de Latencia IA:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbEfficiency" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="eco" />
                            <ComboBoxItem Content="balanced" />
                            <ComboBoxItem Content="high" />
                        </ComboBox>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Posición del Overlay:" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbOverlayPos" Grid.Row="9" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="top-right" />
                            <ComboBoxItem Content="top-left" />
                            <ComboBoxItem Content="top-center" />
                            <ComboBoxItem Content="bottom-right" />
                            <ComboBoxItem Content="bottom-left" />
                        </ComboBox>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Monitor (1..N):" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbMonitor" Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Tecla Pausar:" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPauseKey" Grid.Row="11" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Tecla Analizar Ahora:" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtAnalyzeKey" Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Tecla Mute Mic Live:" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtMicKey" Grid.Row="13" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: F8, Ctrl+M" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Modo de Micrófono (Live):" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbMicInputMode" Grid.Row="14" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="🎙 Mic Abierto (Eco RMS + Barge-in)" Tag="open_mic" />
                            <ComboBoxItem Content="⌨ Push-to-Talk (mantener tecla para hablar)" Tag="push_to_talk" />
                        </ComboBox>

                        <TextBlock Grid.Row="15" Grid.Column="0" Text="Tecla Push-to-Talk:" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPttKey" Grid.Row="15" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: V, Alt, CapsLock, Space, Mouse4, Mouse5" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Micrófono (Entrada WinMM):" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbMicDevice" Grid.Row="16" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="17" Grid.Column="0" Text="Salida Live (Parlantes):" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbSpeakerDevice" Grid.Row="17" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Tamaño del Overlay:" VerticalAlignment="Center" />
                        <Slider x:Name="SldOverlayScale" Grid.Row="18" Grid.Column="1" Minimum="0.75" Maximum="1.45" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                        <TextBlock x:Name="LblOverlayScale" Grid.Row="18" Grid.Column="2" Text="100%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="19" Grid.Column="0" Text="Opacidad del Overlay:" VerticalAlignment="Center" />
                        <Slider x:Name="SldOverlayOpacity" Grid.Row="19" Grid.Column="1" Minimum="0.45" Maximum="1.0" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                        <TextBlock x:Name="LblOverlayOpacity" Grid.Row="19" Grid.Column="2" Text="90%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Volumen Voz:" VerticalAlignment="Center" />
                        <Slider x:Name="SldVolume" Grid.Row="20" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged" />
                        <TextBlock x:Name="LblVolumePct" Grid.Row="20" Grid.Column="2" Text="75%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="💾 Guardar y Aplicar en Vivo" Background="#0284C7" BorderBrush="#38BDF8" Click="BtnSaveConfig_Click" Margin="0,0,10,8" />
                        <Button Content="👁 Probar Overlay + Voz" Click="BtnPreviewOverlay_Click" Margin="0,0,10,8" />
                        <Button x:Name="BtnTestMic" Content="🎤 Probar Micrófono" Click="BtnTestMic_Click" Margin="0,0,10,8" />
                        <Button Content="🎮 Instalar GSI Oficial (CS2 / Dota 2)" Click="BtnInstallGsi_Click" Margin="0,0,10,8" ToolTip="Crea gamestate_integration_hudmind.cfg en Steam sin tocar memoria del juego" />
                        <Button x:Name="BtnCheckUpdates" Content="🔄 Buscar Actualizaciones" Click="BtnCheckUpdates_Click" Margin="0,0,0,8" ToolTip="Verifica si hay una nueva versión disponible en GitHub Releases" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
