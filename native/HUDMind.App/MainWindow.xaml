<Window x:Class="HUDMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HUDMind.App.Controls"
        Title="HUDMind — Coach Táctico de Videojuegos en Tiempo Real"
        Icon="Assets/hudmind.ico"
        Width="1100"
        Height="740"
        MinWidth="920"
        MinHeight="640"
        Background="#070C13"
        Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT TACTICAL NAVIGATION SIDEBAR (0% GPU) -->
        <Border Grid.Column="0" Background="#0A111A" BorderBrush="#152434" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">
                <!-- Brand Wordmark & Geometric Chip Icon -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,18">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#09212E" BorderBrush="#22D3EE" BorderThickness="1" Margin="0,0,9,0">
                        <Path Data="M7,9 H17 V15 H7 Z M4,10 H7 M4,14 H7 M17,10 H20 M17,14 H20 M10,6 V9 M14,6 V9 M10,15 V18 M14,15 V18"
                              Stroke="#22D3EE"
                              StrokeThickness="1.6"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HUD" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="mind" FontSize="18" FontWeight="Light" Foreground="#22D3EE" />
                        </StackPanel>
                        <TextBlock Text="CO-PILOT NATIVO" FontSize="8.5" FontWeight="Bold" Foreground="#5E7891" />
                    </StackPanel>
                </StackPanel>

                <!-- Bottom System / Security / Version Dock -->
                <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
                    <Border Background="#071B19" BorderBrush="#134E4A" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtHeaderBadge"
                                   Text="🛡 0% GPU · Anti-Cheat Safe"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#6EE7B7"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <DockPanel>
                        <Button x:Name="BtnVersionCheck"
                                DockPanel.Dock="Left"
                                Content="v1.5.2"
                                FontSize="10.5"
                                Padding="9,4"
                                Background="#09121C"
                                BorderBrush="#1A2C40"
                                Foreground="#8EA4BC"
                                ToolTip="Clic para buscar actualizaciones en GitHub Releases"
                                Click="BtnCheckUpdates_Click" />
                        <TextBlock Text=".NET 9"
                                   DockPanel.Dock="Right"
                                   Foreground="#4F667C"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>

                <!-- Personal Account / Profile Card + Primary Navigation Stack -->
                <StackPanel VerticalAlignment="Top">
                    <Border x:Name="ProfileCardBorder"
                            Background="#0B1522"
                            BorderBrush="#1A3248"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="TxtActiveUserAvatar"
                                           Text="🎮"
                                           FontSize="19"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveUserName"
                                               Text="Jugador Principal"
                                               Foreground="#22D3EE"
                                               FontWeight="Bold"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtActiveUserSub"
                                               Text="Cuenta local · Libre"
                                               Foreground="#7C96B0"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,5,0,0">
                                <Button x:Name="BtnLockSession"
                                        DockPanel.Dock="Right"
                                        Content="🔒"
                                        FontSize="9.5"
                                        Padding="5,1"
                                        Margin="4,0,0,0"
                                        Background="#1E1B2E"
                                        BorderBrush="#6366F1"
                                        Visibility="Collapsed"
                                        ToolTip="Bloquear sesión ahora (requiere PIN)"
                                        Click="BtnLockSession_Click" />
                                <Button DockPanel.Dock="Right"
                                        Content="📋"
                                        FontSize="9.5"
                                        Padding="5,1"
                                        Background="#0E1826"
                                        BorderBrush="#1A2C40"
                                        ToolTip="Copiar tu identificador único (letras + números)"
                                        Click="BtnCopyUserId_Click" />
                                <TextBlock x:Name="TxtActiveUserUniqueId"
                                           Text="ID: HM-XXXX-XXXX-XXXX"
                                           Foreground="#67E8F9"
                                           FontFamily="Consolas"
                                           FontSize="9.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="👤 Mi Perfil"
                                        FontSize="10.5"
                                        Padding="7,3"
                                        Background="#102031"
                                        BorderBrush="#21405C"
                                        ToolTip="Cambiar de persona, crear cuenta local o activar PIN privado"
                                        Click="BtnManageProfiles_Click" />
                                <Button Grid.Column="2"
                                        Content="💾 Backup"
                                        FontSize="10.5"
                                        Padding="7,3"
                                        Background="#0E1826"
                                        BorderBrush="#1A2C40"
                                        ToolTip="Exportar o importar cuenta portátil cifrada (.hudmind)"
                                        Click="BtnQuickBackup_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MÓDULOS" Foreground="#4E667D" FontSize="9.5" FontWeight="Bold" Margin="8,0,0,6" />
                    <RadioButton x:Name="NavCoach" GroupName="HudNavGroup" Style="{StaticResource SidebarNavButton}" IsChecked="True" Content="👁  Observador" />
                    <RadioButton x:Name="NavAccounts" GroupName="HudNavGroup" Style="{StaticResource SidebarNavButton}" Content="🤖  Proveedores IA" />
                    <RadioButton x:Name="NavGames" GroupName="HudNavGroup" Style="{StaticResource SidebarNavButton}" Content="🗂  Juegos y Memoria" />
                    <RadioButton x:Name="NavSettings" GroupName="HudNavGroup" Style="{StaticResource SidebarNavButton}" Content="🎙  Voz y Ajustes" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT MAIN WORKSPACE -->
        <Grid Grid.Column="1" Background="#070C13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP TACTICAL BAR (Game Cartridge + Active Pill + Primary Co-Pilot Controls) -->
            <Border Grid.Row="0" Background="#091019" BorderBrush="#152434" BorderThickness="0,0,0,1" Padding="14,10">
                <DockPanel>
                    <!-- Left: Active Game Cartridge Selector & Live Status Pill -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Background="#0B1623" BorderBrush="#1A2E42" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" VerticalAlignment="Center" Foreground="#22D3EE" Margin="0,0,6,0" />
                                <ComboBox x:Name="CmbGameProfile"
                                          Width="210"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="GameId"
                                          ToolTip="Elegí un juego puntual o dejalo en Automático para detectarlo solo al abrirlo" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="StatusPillBorder"
                                Background="#0B131E"
                                BorderBrush="#1A2C40"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="HeaderStatusText"
                                           Text="Listo para jugar"
                                           Foreground="#94A3B8"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PauseBadge"
                                Background="#2B1E09"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock Text="PAUSADO" FontSize="10.5" FontWeight="Bold" Foreground="#FCD34D" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Co-Pilot Action Cluster -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnAnalyzeNow" Content="🎯 Analizar (F10)" Padding="11,6" Click="BtnAnalyzeNow_Click" IsEnabled="False" Margin="0,0,7,0" />
                        <Button x:Name="BtnPause" Content="⏸ Pausar (F9)" Padding="11,6" Click="BtnPause_Click" IsEnabled="False" Margin="0,0,9,0" />
                        <Button x:Name="BtnStartStop"
                                Content="▶ Activar Coach"
                                Background="#086F83"
                                BorderBrush="#22D3EE"
                                Foreground="#ECFEFF"
                                Padding="15,6"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Click="BtnStartStop_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- In-App Update Notification Banner -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#0B2D3E"
                    BorderBrush="#22D3EE"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9"
                    Margin="14,10,14,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnDownloadUpdate"
                                Content="⬇ Descargar actualización"
                                Background="#059669"
                                BorderBrush="#10B981"
                                Foreground="#FFFFFF"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Click="BtnDownloadUpdate_Click" />
                        <Button x:Name="BtnLaunchUpdate"
                                Content="▶ Abrir nuevo .exe"
                                Background="#0284C7"
                                BorderBrush="#22D3EE"
                                Foreground="#FFFFFF"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="BtnLaunchUpdate_Click" />
                        <Button x:Name="BtnOpenUpdateFolder"
                                Content="📂 Carpeta"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="BtnOpenUpdateFolder_Click" />
                        <Button x:Name="BtnOpenReleasePage"
                                Content="🌐 Ver en GitHub"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                Click="BtnOpenReleasePage_Click" />
                        <Button x:Name="BtnDismissUpdate"
                                Content="✕"
                                Padding="8,5"
                                ToolTip="Ocultar aviso (o cancelar descarga en curso)"
                                Click="BtnDismissUpdate_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUpdateBannerTitle"
                                   Text="🚀 Nueva actualización disponible"
                                   Foreground="#F8FAFC"
                                   FontWeight="Bold"
                                   FontSize="13" />
                        <TextBlock x:Name="TxtUpdateBannerDetails"
                                   Text=""
                                   Foreground="#CFFAFE"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <ProgressBar x:Name="UpdateProgressBar"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="100"
                                     Margin="0,6,0,0"
                                     Background="#082F49"
                                     Foreground="#10B981"
                                     BorderThickness="0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CONTENT PAGES (Hidden native TabStrip, controlled cleanly via HudNavigationMediator) -->
            <TabControl x:Name="MainTabs" Grid.Row="2" Style="{StaticResource HiddenStripTabControl}" Margin="14,12,14,14">

                <!-- PAGE 1: OBSERVER / LIVE COACH COCKPIT -->
                <TabItem Header="Observador">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Onboarding Quick Banner -->
                        <Border x:Name="OnboardingBanner" Grid.Row="0" Visibility="Collapsed" Background="#0A2233" CornerRadius="9" Padding="11" Margin="0,0,0,10" BorderBrush="#22D3EE" BorderThickness="1">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button Content="1. Conectar IA Gratis →" Background="#086F83" BorderBrush="#22D3EE" Padding="12,5" Margin="0,0,6,0" Click="BtnGoAccounts_Click" />
                                    <Button Content="2. Voz y Cartel" Padding="10,5" Margin="0,0,6,0" Click="BtnGoSettings_Click" />
                                    <Button Content="✕" Padding="8,5" ToolTip="Ocultar guía" Click="BtnDismissOnboarding_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="👋 Empezá en 30 segundos (Gratis · 0% GPU)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="1) Pegá tu clave gratis de Groq o Gemini en 'Proveedores IA' → 2) Probá tu voz y cartel → 3) Tocá Activar Coach y abrí tu juego." Foreground="#CFFAFE" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Featured Active Game Profile & Live Telemetry Banner (Modular UserControl) -->
                        <controls:ActiveProfileBanner x:Name="ActiveBanner" Grid.Row="1" Margin="0,0,0,10" />

                        <!-- Compact Tactical Modes & Routing Strip -->
                        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="11,9" Margin="0,0,0,10">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Comunicación:" VerticalAlignment="Center" Foreground="#22D3EE" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbCommMode" Width="184" Margin="0,0,12,4" SelectionChanged="CmbCommMode_SelectionChanged">
                                    <ComboBoxItem Content="🎙 Charla (Mic + Voz)" Tag="conversation" />
                                    <ComboBoxItem Content="🔊 Solo voz del coach" Tag="coach_voice" />
                                    <ComboBoxItem Content="💬 Solo texto (Sin voz)" Tag="text_only" />
                                </ComboBox>

                                <TextBlock Text="Voz:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbQuickGender" Width="108" Margin="0,0,12,4" SelectionChanged="CmbQuickGender_SelectionChanged">
                                    <ComboBoxItem Content="👨 Hombre" Tag="male" />
                                    <ComboBoxItem Content="👩 Mujer" Tag="female" />
                                </ComboBox>

                                <TextBlock Text="Partida:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbCoachMode" Width="130" Margin="0,0,12,4" SelectionChanged="CmbCoachMode_SelectionChanged">
                                    <ComboBoxItem Content="Automático" Tag="auto" />
                                    <ComboBoxItem Content="Competitiva" Tag="match" />
                                    <ComboBoxItem Content="Entrenamiento" Tag="training" />
                                </ComboBox>

                                <TextBlock Text="Ritmo:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbQuickPacing" Width="148" Margin="0,0,12,4" SelectionChanged="CmbQuickPacing_SelectionChanged" ToolTip="Solo Eventos Clave evita interrupciones de rutina en medio de la acción">
                                    <ComboBoxItem Content="⚡ Continuo" Tag="balanced" />
                                    <ComboBoxItem Content="🎯 Solo Eventos" Tag="event_first" />
                                </ComboBox>

                                <TextBlock Text="Rol:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbQuickRole" Width="168" Margin="0,0,12,4" SelectionChanged="CmbQuickRole_SelectionChanged" ToolTip="Ajusta prioridades tácticas según tu rol o modalidad">
                                    <ComboBoxItem Content="🌐 Auto" Tag="auto" />
                                    <ComboBoxItem Content="🚗 RL · 1v1" Tag="rl_1v1" />
                                    <ComboBoxItem Content="🚗 RL · 2v2/3v3" Tag="rl_2v2_3v3" />
                                    <ComboBoxItem Content="🔫 CS2 · Entry" Tag="cs2_entry" />
                                    <ComboBoxItem Content="🎯 CS2 · AWPer" Tag="cs2_awp" />
                                    <ComboBoxItem Content="🛡️ CS2 · Anchor/IGL" Tag="cs2_anchor" />
                                    <ComboBoxItem Content="⚡ Val · Duelista" Tag="val_duelist" />
                                    <ComboBoxItem Content="🌫️ Val · Control" Tag="val_controller" />
                                    <ComboBoxItem Content="🌲 LoL · Jungla" Tag="lol_jungle" />
                                    <ComboBoxItem Content="⚔️ LoL · Laner" Tag="lol_lane" />
                                    <ComboBoxItem Content="💖 LoL · Support" Tag="lol_support" />
                                </ComboBox>

                                <TextBlock Text="Modo IA:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbEngineType" Width="180" Margin="0,0,12,4" ToolTip="Live permite hablar en tiempo real (~0.9s); Turnos analiza jugadas cada pocos segundos">
                                    <ComboBoxItem Content="🎙 Live en Vivo (~0.9s)" Tag="live" />
                                    <ComboBoxItem Content="⚡ Turnos Automáticos" Tag="classic" />
                                </ComboBox>

                                <TextBlock Text="Pantalla:" VerticalAlignment="Center" Foreground="#8EA4BC" FontSize="12" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbRunMode" Width="162" Margin="0,0,0,4" SelectedIndex="0" ToolTip="Auto-Detectar espera a que abras el juego; Modo Prueba analiza tu escritorio actual">
                                    <ComboBoxItem Content="Auto-Detectar Juego" Tag="auto" />
                                    <ComboBoxItem Content="Probar en Escritorio" Tag="test" />
                                </ComboBox>
                            </WrapPanel>
                        </Border>

                        <!-- Main Coaching & Chat Feed -->
                        <Border Grid.Row="3" Background="#060A10" CornerRadius="10" Padding="10" BorderBrush="#162435" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="2,0,2,7">
                                    <TextBlock Text="💬 FEED TÁCTICO Y CHAT EN VIVO" Foreground="#22D3EE" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="🧹 Limpiar" Padding="9,2" FontSize="11" Click="BtnClearFeed_Click" />
                                </DockPanel>
                                <ListBox x:Name="LstCoachFeed"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackgroundHex}"
                                                    BorderBrush="#16283B"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,7"
                                                    Margin="0,2,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.5" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AccentHex}" CornerRadius="2" Margin="0,1,0,1" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" Foreground="#5C738A" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Author}" Foreground="{Binding AuthorForegroundHex}" FontWeight="Bold" FontSize="11.5" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Message}" Foreground="#F1F5F9" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Collapsible Live Event Latency Log Terminal -->
                        <Expander Grid.Row="4" Margin="0,8,0,0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="LIVE EVENT LATENCY LOG · Sensores, captura y red" Foreground="#8EA4BC" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                            </Expander.Header>
                            <Grid MaxHeight="145">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="Claves API redactadas automáticamente · Clic derecho para copiar línea" Foreground="#5C738A" FontSize="11" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="🧹 Limpiar Logs" Padding="9,2" FontSize="11" Click="BtnClearLogs_Click" />
                                </DockPanel>
                                <ListBox x:Name="LstLiveLogs"
                                         Grid.Row="1"
                                         Background="#05090F"
                                         BorderBrush="#162435"
                                         BorderThickness="1"
                                         Foreground="#8EA4BC"
                                         FontFamily="Consolas"
                                         FontSize="11.5"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ContextMenu>
                                        <ContextMenu Background="#0A121D" Foreground="#F1F5F9" BorderBrush="#22D3EE">
                                            <MenuItem Header="📋 Copiar línea seleccionada" Click="MenuCopyLog_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#8EA4BC" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Expander>

                        <!-- Bottom Interactive Chat & Post-Match Review Bar -->
                        <Border Grid.Row="5" Style="{StaticResource CardPanel}" Padding="9" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💬 Preguntale:" Foreground="#22D3EE" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBox x:Name="TxtChatInput"
                                         Grid.Column="1"
                                         Margin="0,0,8,0"
                                         IsEnabled="False"
                                         KeyDown="TxtChatInput_KeyDown"
                                         ToolTip="Escribí una pregunta mientras jugás (el coach ve tu pantalla actual) · Presioná Enter para enviar" />
                                <Button x:Name="BtnSendChat"
                                        Grid.Column="2"
                                        Content="Enviar ↵"
                                        Background="#086F83"
                                        BorderBrush="#22D3EE"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="BtnSendChat_Click" />
                                <Button x:Name="BtnMatchReview"
                                        Grid.Column="3"
                                        Content="📊 Resumen Partida"
                                        IsEnabled="False"
                                        Margin="0,0,8,0"
                                        ToolTip="Analiza tus errores de la última partida y te da 1 ejercicio práctico para la siguiente"
                                        Click="BtnMatchReview_Click" />
                                <Button x:Name="BtnOpenReviews"
                                        Grid.Column="4"
                                        Content="📂 Resúmenes"
                                        ToolTip="Abre la carpeta donde se guardan tus resúmenes post-partida"
                                        Click="BtnOpenReviews_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- PAGE 2: AI PROVIDERS -->
                <TabItem Header="Proveedores IA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource FeaturedCardPanel}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                    <Button x:Name="BtnOpenRouterPkce" Content="🔐 Entrar OpenRouter (1 clic)" Background="#086F83" BorderBrush="#22D3EE" Click="BtnOpenRouterPkce_Click" Margin="0,0,6,0" ToolTip="Abre tu navegador e importa automáticamente tu clave personal sin copiar ni pegar nada" />
                                    <Button Content="✨ Gemini 2 clics" Background="#1E3A5F" BorderBrush="#38BDF8" Click="BtnGuidedGemini_Click" Margin="0,0,6,0" ToolTip="Asistente visual guiado para conectar tu clave gratis de Google AI Studio sin saber programar" />
                                    <Button Content="🌐 Groq (Gratis)" Background="#059669" BorderBrush="#10B981" Click="BtnOpenGroq_Click" ToolTip="Abre Groq Console para obtener tu API Key gratuita de respuesta ultrarrápida (~0.4s)" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚡ CONECTÁ TU IA SIN SABER PROGRAMAR ($0 GRATIS)" Foreground="#22D3EE" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Text="Entrá directo con OpenRouter en 1 clic automático, usá el asistente guiado de Google Gemini Live (con voz), o pegá tu clave gratis de Groq abajo." Foreground="#B5D3E7" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListView x:Name="LstAccounts" Grid.Row="1" Background="#0A121D" Foreground="#F1F5F9" BorderBrush="#182A3D" Margin="0,0,0,10" MouseDoubleClick="LstAccounts_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Orden" Width="48" DisplayMemberBinding="{Binding Priority}" />
                                    <GridViewColumn Header="Nombre" Width="195" DisplayMemberBinding="{Binding Label}" />
                                    <GridViewColumn Header="Servicio" Width="115" DisplayMemberBinding="{Binding ProviderDisplay}" />
                                    <GridViewColumn Header="Capacidades" Width="95" DisplayMemberBinding="{Binding VisionDisplay}" />
                                    <GridViewColumn Header="Clave" Width="125" DisplayMemberBinding="{Binding MaskedKeyDisplay}" />
                                    <GridViewColumn Header="Activa" Width="60" DisplayMemberBinding="{Binding EnabledDisplay}" />
                                    <GridViewColumn Header="Modelo" Width="195" DisplayMemberBinding="{Binding Model}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Servicio de IA:" Foreground="#8EA4BC" FontSize="11" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CmbNewProvider" DisplayMemberPath="FriendlyName" SelectedValuePath="Id" SelectionChanged="CmbNewProvider_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Nombre (ej: Mi Groq):" Foreground="#8EA4BC" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="TxtNewLabel" Text="Groq LPU Gratis (~0.4s)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Tu Clave API (oculta si hacés stream en OBS/Discord):" Foreground="#8EA4BC" FontSize="11" Margin="0,0,0,3" />
                                        <PasswordBox x:Name="PwdNewApiKey" ToolTip="Pegá tu API Key (queda oculta con puntos para cuidar tu privacidad)" />
                                    </StackPanel>
                                    <Button x:Name="BtnAddAccount" Grid.Column="3" Content="+ Conectar IA" VerticalAlignment="Bottom" Background="#059669" BorderBrush="#10B981" Padding="14,6" Click="BtnAddAccount_Click" />
                                    <Button x:Name="BtnCancelEdit" Grid.Column="4" Content="Cancelar" VerticalAlignment="Bottom" Visibility="Collapsed" Margin="6,0,0,0" Click="BtnCancelEdit_Click" />
                                </Grid>

                                <Expander x:Name="ExpAccountAdvanced" Margin="0,10,0,0" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="⚙ Opciones avanzadas (modelo específico, servidor propio / Ollama, modo solo texto)" Foreground="#8EA4BC" FontSize="11.5" />
                                    </Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="175" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Modelo:" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="TxtNewModel" Grid.Column="1" Margin="0,0,12,0" Text="meta-llama/llama-4-scout-17b-16e-instruct" />
                                        <TextBlock Grid.Column="2" Text="Servidor (opcional):" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="TxtNewBaseUrl"
                                                 Grid.Column="3"
                                                 Margin="0,0,12,0"
                                                 ToolTip="Solo si usás un servidor HTTPS propio o Ollama local (http://localhost:11434/v1). Dejar vacío para usar el oficial." />
                                        <TextBlock Grid.Column="4" Text="Modo:" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="CmbNewVisionOverride"
                                                  Grid.Column="5"
                                                  SelectedIndex="0"
                                                  ToolTip="Automático detecta si el modelo ve imágenes; Solo Texto usa lectura de pantalla + logs.">
                                            <ComboBoxItem Content="Automático" Tag="auto" />
                                            <ComboBoxItem Content="Con Visión (Imagen)" Tag="vision" />
                                            <ComboBoxItem Content="Solo Texto (OCR+Logs)" Tag="text" />
                                        </ComboBox>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Button Content="↑ Prioridad +" Click="BtnMoveUp_Click" Margin="0,0,6,0" />
                            <Button Content="↓ Prioridad -" Click="BtnMoveDown_Click" Margin="0,0,6,0" />
                            <Button x:Name="BtnEditAccount" Content="✏ Editar" Click="BtnEditAccount_Click" Margin="0,0,6,0" />
                            <Button Content="Activar / Pausar" Click="BtnToggleAccount_Click" Margin="0,0,6,0" />
                            <Button x:Name="BtnTestAccount" Content="🔍 Probar Conexión" Click="BtnTestAccount_Click" Margin="0,0,6,0" />
                            <Button Content="Eliminar" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteAccount_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- PAGE 3: GAME CARTRIDGES & ROLLING MARKDOWN MEMORY -->
                <TabItem Header="Juegos y Memoria">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Cartucho de Juego:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#22D3EE" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbRulesGame" Width="250" DisplayMemberPath="DisplayName" SelectedValuePath="GameId" SelectionChanged="CmbRulesGame_SelectionChanged" />
                            </StackPanel>
                            <TextBlock x:Name="LblRulesCount" DockPanel.Dock="Right" Text="0 / 600 caracteres" Foreground="#8EA4BC" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="195" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="+ Nuevo Juego" Foreground="#22D3EE" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Nombre:" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtNewProfName" Grid.Column="2" Margin="0,0,10,0" ToolTip="Nombre del juego (ej: Apex Legends, Fortnite)" />
                                <TextBlock Grid.Column="3" Text="Archivo (.exe):" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtNewProfExe" Grid.Column="4" Margin="0,0,6,0" ToolTip="Nombre del archivo del juego (ej: r5apex.exe) o usá 'Elegir .exe'" />
                                <Button x:Name="BtnBrowseNewExe" Grid.Column="5" Content="📂 Elegir .exe" Margin="0,0,8,0" Click="BtnBrowseNewExe_Click" ToolTip="Buscá el .exe del juego en tu PC sin tener que escribirlo" />
                                <Button x:Name="BtnCreateProfile" Grid.Column="6" Content="➕ Agregar" Background="#059669" BorderBrush="#10B981" Click="BtnCreateProfile_Click" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="📝 Indicaciones personales para el coach en este juego (opcional):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <WrapPanel>
                                <TextBlock Text="Ideas rápidas:" Foreground="#5C738A" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <Button Style="{StaticResource ChipButton}" Content="+ Sé breve, solo jugadas clave" Tag="Sé breve y directo: avisame solo en jugadas clave." Margin="0,0,6,4" Click="BtnPromptChip_Click" />
                                <Button Style="{StaticResource ChipButton}" Content="+ Controlar recursos / boost" Tag="Avisame cuando esté bajo de recursos, vida o boost." Margin="0,0,6,4" Click="BtnPromptChip_Click" />
                                <Button Style="{StaticResource ChipButton}" Content="+ Cuidar posicionamiento" Tag="Recordame cuidar el posicionamiento y no regalar ventaja." Margin="0,0,0,4" Click="BtnPromptChip_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBox x:Name="TxtCustomRules"
                                 Grid.Row="3"
                                 MaxLength="600"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Padding="10"
                                 TextChanged="TxtCustomRules_TextChanged" />

                        <Expander Grid.Row="4" Margin="0,8,0,0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="⚙ Sensibilidad perceptual (pHash), pausas y ejecutables .exe" Foreground="#8EA4BC" FontSize="11.5" />
                            </Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Archivos .exe:" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtProfileExes" Grid.Column="1" Margin="0,0,12,0" ToolTip="Ejecutables del juego separados por coma" />
                                <TextBlock Grid.Column="2" Text="Pausa entre avisos (seg):" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtProfileCooldown" Grid.Column="3" Margin="0,0,12,0" ToolTip="Segundos mínimos entre consejos automáticos (1 a 120)" />
                                <TextBlock Grid.Column="4" Text="Sensibilidad pHash (1–64):" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtProfilePhash" Grid.Column="5" ToolTip="Menor número = reacciona ante cambios más chicos en pantalla (recomendado: 6 a 10)" />
                            </Grid>
                        </Expander>

                        <Border Grid.Row="5" Style="{StaticResource FeaturedCardPanel}" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="📂 Memoria (.md)" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" Click="BtnOpenGameMemory_Click" ToolTip="Abre la carpeta con los resúmenes Markdown por juego e índice INDEX.md" />
                                        <Button x:Name="BtnResetGameMemory" Content="🧹 Limpiar memoria" Padding="10,4" FontSize="11.5" Click="BtnResetGameMemory_Click" ToolTip="Borra los patrones repetidos guardados en las últimas partidas de este juego" />
                                    </StackPanel>
                                    <TextBlock x:Name="LblRollingMemorySummary" Text="🧠 Memoria del coach: sin partidas registradas aún (se actualiza sola al jugar)." Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                </DockPanel>
                                <Border Height="1" Background="#162A3E" Margin="0,7,0,7" />
                                <DockPanel>
                                    <Button x:Name="BtnResetGameLeaks" DockPanel.Dock="Right" Content="🧹 Reset fugas" Padding="10,4" FontSize="11" Click="BtnResetGameLeaks_Click" ToolTip="Reinicia los contadores medibles de errores repetidos (Hoy vs Anterior)" />
                                    <TextBlock x:Name="LblLeaksSummary" Text="📉 Fugas medibles (Hoy vs Anterior): sin errores tácticos repetidos detectados aún." Foreground="#93C5FD" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="6" Margin="0,10,0,0">
                            <Button x:Name="BtnDeleteProfile" DockPanel.Dock="Left" Content="🗑 Eliminar Juego" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteProfile_Click" />
                            <Button Content="💾 Guardar Indicaciones" HorizontalAlignment="Right" Background="#086F83" BorderBrush="#22D3EE" Padding="14,6" Click="BtnSaveRules_Click" />
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- PAGE 4: VOICE, TELEMETRY, OVERLAY & HOTKEYS -->
                <TabItem Header="Voz y Ajustes">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel MaxWidth="850" HorizontalAlignment="Left">

                                <!-- Card 1: Player Profile & Coach Personality -->
                                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🎯 TU NIVEL, PERSONALIDAD Y MEMORIA" Foreground="#22D3EE" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tu Nivel de Juego:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbSkillTier" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBoxItem Content="🌱 Principiante (fundamentos simples y paciencia)" Tag="beginner" />
                                                <ComboBoxItem Content="🥉 Casual (Bronce–Plata / Hierro–Bronce)" Tag="casual" />
                                                <ComboBoxItem Content="🥈 Intermedio (Oro–Platino / Plata–Oro)" Tag="intermediate" />
                                                <ComboBoxItem Content="🥇 Avanzado (Diamante–Campeón / Ascendente)" Tag="advanced" />
                                                <ComboBoxItem Content="🏆 Competitivo / Pro (GC–SSL / Radiant / Faceit 10)" Tag="pro" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tu Rango exacto (opcional):" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtRankLabel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: Platino 2 en 2v2, Diamante 1, Oro 3..." />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Personalidad del Coach:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbCoachStyle" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBoxItem Content="🤝 Amigable y motivador (celebra aciertos)" Tag="friendly" />
                                                <ComboBoxItem Content="🪞 Sincero sin humo (directo + Anti-Tilt)" Tag="honest" />
                                                <ComboBoxItem Content="🎯 Directo y táctico (al punto)" Tag="tactical" />
                                                <ComboBoxItem Content="🔥 Exigente estilo torneo (sin filtro)" Tag="strict" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Idioma del Coach:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbLanguage" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBoxItem Content="🇪🇸 Español" Tag="es" />
                                                <ComboBoxItem Content="🇺🇸 English" Tag="en" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Frecuencia en modo Live:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbLiveAutoRate" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" ToolTip="Buffer continuo estilo OBS (~10 FPS en RAM · 25s historial): observa todo y predice jugadas incluso sin hablar">
                                                <ComboBoxItem Content="🎙 Solo cuando le hablo o toco F10 (sigue mirando tipo OBS)" Tag="0" />
                                                <ComboBoxItem Content="⚖ Equilibrado (cada 10s · jugada completa)" Tag="10" />
                                                <ComboBoxItem Content="⚡ Activo (cada 6s · OBS continuo recomendado)" Tag="6" />
                                                <ComboBoxItem Content="🔥 OBS Máximo (cada 4s · observa y predice todo sin hablar)" Tag="4" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Velocidad vs Nitidez visual:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbEfficiency" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" ToolTip="Rápido consume menos datos y responde antes; Máxima nitidez lee textos muy chicos del HUD">
                                                <ComboBoxItem Content="⚡ Rápido (menor consumo · recomendado)" Tag="eco" />
                                                <ComboBoxItem Content="⚖ Equilibrado (HD)" Tag="balanced" />
                                                <ComboBoxItem Content="💎 Máxima nitidez (Full HD)" Tag="high" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Memoria de partidas:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbMemoryWindow" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" ToolTip="Cantidad de partidas recientes que el coach recuerda (al entrar nuevas se borran las más viejas)">
                                                <ComboBoxItem Content="🧠 Últimas 5 partidas (se adapta rápido)" Tag="5" />
                                                <ComboBoxItem Content="🧠 Últimas 10 partidas (recomendado)" Tag="10" />
                                                <ComboBoxItem Content="🧠 Últimas 20 partidas (historial largo)" Tag="20" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ritmo del Coach (Pacing):" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbCoachingPacing" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbCoachingPacing_SelectionChanged" ToolTip="Solo Eventos Clave evita interrupciones por reloj durante la acción intensa y solo avisa ante eventos reales, alertas críticas o F10">
                                                <ComboBoxItem Content="⚡ Continuo (cada Xs + Eventos)" Tag="balanced" />
                                                <ComboBoxItem Content="🎯 Solo Eventos Clave (Silencio IGL)" Tag="event_first" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Rol / Modo en Partida:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbPlayerRole" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbPlayerRole_SelectionChanged" ToolTip="Ajusta las prioridades tácticas del coach según tu rol o modalidad de juego">
                                                <ComboBoxItem Content="🌐 Automático (según contexto)" Tag="auto" />
                                                <ComboBoxItem Content="🚗 Rocket League · 1v1 (Duelos)" Tag="rl_1v1" />
                                                <ComboBoxItem Content="🚗 Rocket League · 2v2 / 3v3 (Backpost)" Tag="rl_2v2_3v3" />
                                                <ComboBoxItem Content="🔫 CS2 · Entry Fragger" Tag="cs2_entry" />
                                                <ComboBoxItem Content="🎯 CS2 · AWPer" Tag="cs2_awp" />
                                                <ComboBoxItem Content="🛡️ CS2 · Anchor / IGL" Tag="cs2_anchor" />
                                                <ComboBoxItem Content="⚡ Valorant · Duelista" Tag="val_duelist" />
                                                <ComboBoxItem Content="🌫️ Valorant · Control / Sentinela" Tag="val_controller" />
                                                <ComboBoxItem Content="🌲 LoL · Jungla" Tag="lol_jungle" />
                                                <ComboBoxItem Content="⚔️ LoL · Laner" Tag="lol_lane" />
                                                <ComboBoxItem Content="💖 LoL · Support" Tag="lol_support" />
                                            </ComboBox>
                                        </Grid>

                                        <Expander Margin="0,10,0,0" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="🎭 Personalidad (coach_soul.md) y Perfil Global (player_profile.md)" Foreground="#8EA4BC" FontSize="11.5" />
                                            </Expander.Header>
                                            <StackPanel Margin="0,6,0,0">
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Content="📂 Abrir archivos .md" Padding="9,3" FontSize="11" Click="BtnOpenSoulFolder_Click" ToolTip="Abre la carpeta config/ para editar o compartir coach_soul.md y player_profile.md" />
                                                    <TextBlock Text="Cómo querés que sea tu coach (coach_soul.md):" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBox x:Name="TxtCoachSoul" Height="64" MaxLength="700" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

                                                <TextBlock Text="Tus hábitos globales entre todos los juegos (player_profile.md):" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPlayerProfile" Height="56" MaxLength="700" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Voice, TTS, Mic & Spectrum Preview -->
                                <Border Style="{StaticResource FeaturedCardPanel}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="🎙 VOICE &amp; TTS · SALIDA 24kHz PRE-BUFFERED" Foreground="#10B981" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button x:Name="BtnTestMic" DockPanel.Dock="Right" Content="🎤 Probar Micrófono" Padding="10,4" Click="BtnTestMic_Click" />
                                        </DockPanel>

                                        <!-- Reusable Vector Spectrum Bar echoing cyber-tactical HUD audio aesthetics -->
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Background="#071B19" BorderBrush="#134E4A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Anti-Click + Catmull-Rom 24kHz" Foreground="#6EE7B7" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>
                                            <controls:AudioWaveformControl x:Name="SettingsVoiceWave" />
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="360" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo de Comunicación:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbCommModeSettings" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbCommModeSettings_SelectionChanged">
                                                <ComboBoxItem Content="🎙 Charla (Micrófono + Voz del coach)" Tag="conversation" />
                                                <ComboBoxItem Content="🔊 Solo voz del coach (mic apagado)" Tag="coach_voice" />
                                                <ComboBoxItem Content="💬 Solo texto (100% silencioso)" Tag="text_only" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Voz del Coach:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbVoiceGender" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                                                <ComboBoxItem Content="👨 Hombre (Fenrir / Tomás)" Tag="male" />
                                                <ComboBoxItem Content="👩 Mujer (Aoede / Elena)" Tag="female" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Calidad de Voz (Turnos):" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbVoiceStyle" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                                                <ComboBoxItem Content="🎙 Voz Natural Windows (recomendada)" Tag="neural" />
                                                <ComboBoxItem Content="⚡ Instantánea ultra-rápida (~8ms)" Tag="instant" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Velocidad de Voz:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbVoiceRate" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceRate_SelectionChanged" ToolTip="Bajá a Natural o Pausada si querés que se entienda con total claridad sobre el sonido del juego">
                                                <ComboBoxItem Content="🐢 Pausada y muy clara (-10%)" Tag="-10%" />
                                                <ComboBoxItem Content="🎯 Natural (0% · máxima dicción)" Tag="+0%" />
                                                <ComboBoxItem Content="✨ Clara y ágil (+5% · recomendada)" Tag="+5%" />
                                                <ComboBoxItem Content="⚡ Rápida (+15%)" Tag="+15%" />
                                                <ComboBoxItem Content="🚀 Muy rápida (+25%)" Tag="+25%" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Uso del Micrófono (Live):" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbMicInputMode" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBoxItem Content="🎙 Mic Abierto (hablás cuando querés)" Tag="open_mic" />
                                                <ComboBoxItem Content="⌨ Push-to-Talk (mantener tecla para hablar)" Tag="push_to_talk" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Tecla Push-to-Talk:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtPttKey" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: V, Alt, CapsLock, Space, Mouse4, Mouse5" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Micrófono:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbMicDevice" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Auriculares / Parlantes:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbSpeakerDevice" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Volumen de Voz:" VerticalAlignment="Center" />
                                            <Slider x:Name="SldVolume" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged" />
                                            <TextBlock x:Name="LblVolumePct" Grid.Row="8" Grid.Column="2" Text="75%" Foreground="#22D3EE" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                        <CheckBox x:Name="ChkEnableAudioCues" Content="Sonidos suaves de confirmación (al pausar, mutear mic o pulsar Push-to-Talk)" Margin="0,8,0,0" ToolTip="Emite un tono sutil al usar atajos (silenciado en modo Solo Texto)." />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Floating In-Game HUD Overlay -->
                                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="💬 CARTEL HUD SOBRE EL JUEGO (OVERLAY · 0% GPU)" Foreground="#22D3EE" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Content="👁 Probar HUD + Voz" Padding="10,4" Click="BtnPreviewOverlay_Click" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="ChkEnableOverlay" Content="Mostrar cartel sobre el juego (transparente al mouse)" Margin="0,0,20,6" />
                                            <CheckBox x:Name="ChkOverlayFollowMonitor" Content="Seguir monitor activo del juego" Margin="0,0,20,6" ToolTip="Reubica automáticamente el cartel al monitor donde estés jugando." />
                                            <CheckBox x:Name="ChkEnableCompanionHud" Content="Companion Web HUD (Pantalla Completa / 2º monitor)" Margin="0,0,20,6" Checked="CompanionHudSettingChanged" Unchecked="CompanionHudSettingChanged" ToolTip="Inicia un mini HUD web local (0% GPU, 0% riesgo anti-cheat) para verlo en otro monitor, OBS Browser Source o el celular." />
                                            <CheckBox x:Name="ChkCompanionLan" Content="Permitir celular en Wi-Fi (LAN)" Margin="0,0,20,6" Checked="CompanionHudSettingChanged" Unchecked="CompanionHudSettingChanged" ToolTip="Habilita acceso por red Wi-Fi local usando una URL con clave temporal de sesión." />
                                            <CheckBox x:Name="ChkEnableInGameOverlayBridge" Content="Puente HUD externo en juego (Pantalla Completa)" Margin="0,0,0,6" Checked="InGameOverlayBridgeSettingChanged" Unchecked="InGameOverlayBridgeSettingChanged" ToolTip="Reenvía callouts finales vía WebSocket local (127.0.0.1 RCON) a puentes/mods compatibles del propio juego para ver avisos dentro de pantalla completa exclusiva sin hooks." />
                                        </WrapPanel>
                                        <Border x:Name="CompanionUrlBar" Visibility="Collapsed" Background="#07101B" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <DockPanel LastChildFill="True">
                                                <Border x:Name="BorderCompanionQr" DockPanel.Dock="Right" Visibility="Collapsed" Background="#FFFFFF" CornerRadius="4" Padding="4" Margin="10,0,0,0" ToolTip="Escaneá este QR con tu celular en la misma Wi-Fi para abrir el Companion HUD sin tipear nada">
                                                    <Image x:Name="ImgCompanionQr" Width="92" Height="92" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Content="🌐 Abrir" Padding="9,4" Margin="6,0,0,0" Click="BtnOpenCompanionUrl_Click" ToolTip="Abre el HUD Companion en tu navegador" />
                                                        <Button DockPanel.Dock="Right" Content="📺 URL OBS" Padding="9,4" Margin="6,0,0,0" Click="BtnCopyCompanionObsUrl_Click" ToolTip="Copia la URL transparente (?mode=obs) ideal para OBS Browser Source" />
                                                        <Button DockPanel.Dock="Right" Content="📋 Copiar" Padding="9,4" Margin="6,0,0,0" Click="BtnCopyCompanionUrl_Click" />
                                                        <TextBlock DockPanel.Dock="Left" Text="URL Companion:" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBox x:Name="TxtCompanionUrl" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#22D3EE" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock x:Name="TxtCompanionQrHint" Visibility="Collapsed" Text="📱 Escaneá el QR con tu celular (misma Wi-Fi) o usá '📺 URL OBS' para overlay transparente en OBS." Foreground="#64748B" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="128" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Estilo del Overlay:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbOverlayStyle" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbOverlayVisual_SelectionChanged" ToolTip="El texto se mantiene nítido con sombra 0% GPU incluso con fondo 0% transparente">
                                                <ComboBoxItem Content="🫥 Solo texto flotante (sin caja ni bordes)" Tag="transparent_text" />
                                                <ComboBoxItem Content="💠 Cápsula translúcida (estilo Discord)" Tag="discord_pill" />
                                                <ComboBoxItem Content="🖥 Tarjeta táctica completa (onda + atajos)" Tag="card" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mensajes en Pantalla:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbOverlayFeedLines" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbOverlayVisual_SelectionChanged" ToolTip="Elegí ver un solo consejo táctico o un mini-feed apilado estilo Discord Overlay">
                                                <ComboBoxItem Content="💬 Mini-feed Discord (últimos 3 mensajes)" Tag="3" />
                                                <ComboBoxItem Content="⚡ Aviso único (solo el último consejo)" Tag="1" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Posición en Pantalla:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbOverlayPos" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbOverlayVisual_SelectionChanged">
                                                <ComboBoxItem Content="↗ Arriba a la derecha" Tag="top-right" />
                                                <ComboBoxItem Content="↖ Arriba a la izquierda" Tag="top-left" />
                                                <ComboBoxItem Content="⬆ Arriba al centro" Tag="top-center" />
                                                <ComboBoxItem Content="↘ Abajo a la derecha" Tag="bottom-right" />
                                                <ComboBoxItem Content="↙ Abajo a la izquierda" Tag="bottom-left" />
                                                <ComboBoxItem Content="⬇ Abajo al centro (estilo subtítulos)" Tag="bottom-center" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pantalla / Monitor:" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbMonitor" Grid.Row="3" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Index" VerticalAlignment="Center" SelectionChanged="CmbOverlayVisual_SelectionChanged" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tamaño del Texto:" VerticalAlignment="Center" />
                                            <Slider x:Name="SldOverlayScale" Grid.Row="4" Grid.Column="1" Minimum="0.75" Maximum="1.45" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                                            <TextBlock x:Name="LblOverlayScale" Grid.Row="4" Grid.Column="2" Text="100%" Foreground="#22D3EE" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Opacidad del Fondo:" VerticalAlignment="Center" ToolTip="Regulá qué tan translúcida es la caja (0% = transparente, texto siempre nítido)" />
                                            <Slider x:Name="SldOverlayOpacity" Grid.Row="5" Grid.Column="1" Minimum="0.00" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                                            <TextBlock x:Name="LblOverlayOpacity" Grid.Row="5" Grid.Column="2" Text="55%" Foreground="#22D3EE" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Hotkeys & Game Telemetry -->
                                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="⌨ TECLAS RÁPIDAS Y TELEMETRÍA" Foreground="#F59E0B" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,10" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="ChkEnableHotkeys" Content="Activar teclas rápidas dentro del juego" Margin="0,0,20,6" />
                                            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimizar junto al reloj (Bandeja)" Margin="0,0,20,6" />
                                            <CheckBox x:Name="ChkLaunchWithWindows" Content="Iniciar con Windows minimizado junto al reloj" IsChecked="False" Margin="0,0,20,6" ToolTip="Desactivado por defecto: marcalo solo si querés que HUDMind arranque en segundo plano al encender la PC." />
                                            <CheckBox x:Name="ChkCheckUpdatesOnStartup" Content="Avisar nuevas versiones disponibles" Margin="0,0,20,6" ToolTip="Busca actualizaciones en GitHub Releases al abrir y cada 60 min en reposo." />
                                            <CheckBox x:Name="ChkExternalTelemetryWs" Content="Telemetría WebSocket local (ws://127.0.0.1)" Margin="0,0,0,6" ToolTip="Escucha eventos pasivos JSON en loopback (replays, clock, boost, score, hudmind:telemetry). 0 ms de impacto si no hay relay." />
                                        </WrapPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="36" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tecla Pausar / Reanudar:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtPauseKey" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tecla Analizar Ahora:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtAnalyzeKey" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tecla Silenciar Micrófono:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtMicKey" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: F8, Ctrl+M" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tecla Chat Rápido en Juego:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtQuickChatKey" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" ToolTip="Abre un chat rápido flotante sin salir del juego (ej: F7, Alt+Q, Insert)" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Puerto WS Telemetría Local:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtTelemetryWsPort" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" ToolTip="Puerto loopback ws://127.0.0.1 (por defecto 49122, rango 1024-65535)" />
                                        </Grid>
                                        <WrapPanel>
                                            <Button Content="🎮 Activar conexión CS2 / Dota 2" Click="BtnInstallGsi_Click" Margin="0,0,10,4" ToolTip="Instala el archivo oficial de lectura de partida en Steam (100% seguro, sin tocar memoria)" />
                                            <Button x:Name="BtnSetupExternalBridge" Content="🔗 Activar Puente HUD Local (Pantalla Completa)" Click="BtnSetupExternalBridge_Click" Margin="0,0,10,4" ToolTip="Autoriza 'toast' en el puente RCON local instalado (%APPDATA%) y verifica la conexión loopback para mostrar avisos en pantalla completa." />
                                            <Button x:Name="BtnCheckUpdates" Content="🔄 Buscar Actualizaciones" Click="BtnCheckUpdates_Click" Margin="0,0,0,4" ToolTip="Verifica si salió una nueva versión en GitHub Releases" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky Save Bar -->
                        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="11,9" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="Los cambios de volumen, velocidad, cartel y voz se aplican en tiempo real al guardar." Foreground="#8EA4BC" FontSize="11.5" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="💾 Guardar y Aplicar Cambios" Background="#086F83" BorderBrush="#22D3EE" Padding="16,7" Click="BtnSaveConfig_Click" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
