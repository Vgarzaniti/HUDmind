<Window x:Class="HUDMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUDMind — Coach Táctico de Videojuegos en Tiempo Real"
        Icon="Assets/hudmind.ico"
        Width="1020"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        Background="#0B1120"
        Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Image Source="Assets/hudmind-icon.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="HUDMind" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                <Button x:Name="BtnVersionCheck"
                        Content="v1.1.1"
                        FontSize="10.5"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        Foreground="#94A3B8"
                        ToolTip="Clic para buscar actualizaciones en GitHub Releases"
                        Click="BtnCheckUpdates_Click" />
                <Border Background="#10B981" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderBadge" Text="🛡 0% GPU · Anti-Cheat Safe" FontSize="10.5" FontWeight="Bold" Foreground="#052E16" />
                </Border>
                <Border x:Name="PauseBadge" Background="#F59E0B" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="PAUSADO" FontSize="10.5" FontWeight="Bold" Foreground="#1E1B18" />
                </Border>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText"
                           Text="Listo para jugar"
                           Foreground="#CBD5E1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Border>
        </DockPanel>

        <!-- In-App Update Notification Banner (auto-shown when a newer GitHub Release exists) -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#0C4A6E"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                CornerRadius="9"
                Padding="12,9"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnDownloadUpdate"
                            Content="⬇ Descargar actualización"
                            Background="#059669"
                            BorderBrush="#10B981"
                            Foreground="#FFFFFF"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Click="BtnDownloadUpdate_Click" />
                    <Button x:Name="BtnLaunchUpdate"
                            Content="▶ Abrir nuevo .exe"
                            Background="#0284C7"
                            BorderBrush="#38BDF8"
                            Foreground="#FFFFFF"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnLaunchUpdate_Click" />
                    <Button x:Name="BtnOpenUpdateFolder"
                            Content="📂 Carpeta"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnOpenUpdateFolder_Click" />
                    <Button x:Name="BtnOpenReleasePage"
                            Content="🌐 Ver en GitHub"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Click="BtnOpenReleasePage_Click" />
                    <Button x:Name="BtnDismissUpdate"
                            Content="✕"
                            Padding="8,5"
                            ToolTip="Ocultar aviso (o cancelar descarga en curso)"
                            Click="BtnDismissUpdate_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUpdateBannerTitle"
                               Text="🚀 Nueva actualización disponible"
                               Foreground="#F8FAFC"
                               FontWeight="Bold"
                               FontSize="13" />
                    <TextBlock x:Name="TxtUpdateBannerDetails"
                               Text=""
                               Foreground="#BAE6FD"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Height="5"
                                 Minimum="0"
                                 Maximum="100"
                                 Margin="0,6,0,0"
                                 Background="#082F49"
                                 Foreground="#10B981"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="2">

            <!-- TAB 1: GAMER COCKPIT & LIVE COACHING FEED -->
            <TabItem Header="⚡ Coach en Vivo">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Onboarding Quick Banner (auto-shown when no AI account configured) -->
                    <Border x:Name="OnboardingBanner" Grid.Row="0" Visibility="Collapsed" Background="#172554" CornerRadius="9" Padding="11" Margin="0,0,0,10" BorderBrush="#38BDF8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button Content="1. Conectar IA Gratis →" Background="#0284C7" BorderBrush="#38BDF8" Padding="12,5" Margin="0,0,6,0" Click="BtnGoAccounts_Click" />
                                <Button Content="2. Voz y Cartel" Padding="10,5" Margin="0,0,6,0" Click="BtnGoSettings_Click" />
                                <Button Content="✕" Padding="8,5" ToolTip="Ocultar guía" Click="BtnDismissOnboarding_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="👋 Empezá en 30 segundos (Gratis · 0% GPU)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="1) Pegá tu clave gratis de Groq o Gemini en 'Proveedores IA' → 2) Probá tu micrófono y cartel → 3) Tocá Iniciar Coach y abrí tu juego." Foreground="#BAE6FD" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Controls Bar -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="BtnStartStop" Content="▶ Iniciar Coach" Background="#0284C7" BorderBrush="#38BDF8" Padding="16,7" FontSize="13.5" Click="BtnStartStop_Click" Margin="0,0,10,0" />
                                    <Button x:Name="BtnAnalyzeNow" Content="🎯 Analizar (F10)" Padding="12,7" Click="BtnAnalyzeNow_Click" IsEnabled="False" Margin="0,0,8,0" />
                                    <Button x:Name="BtnPause" Content="⏸ Pausar (F9)" Padding="12,7" Click="BtnPause_Click" IsEnabled="False" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="🎮 Juego:" VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CmbGameProfile" Width="210" DisplayMemberPath="DisplayName" SelectedValuePath="GameId" ToolTip="Elegí un juego puntual o dejalo en Automático para detectarlo solo al abrirlo" />
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Comunicación:" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbCommMode" Width="190" Margin="0,0,14,4" SelectionChanged="CmbCommMode_SelectionChanged">
                                    <ComboBoxItem Content="🎙 Charla (Mic + Voz)" Tag="conversation" />
                                    <ComboBoxItem Content="🔊 Solo voz del coach" Tag="coach_voice" />
                                    <ComboBoxItem Content="💬 Solo texto (Sin voz)" Tag="text_only" />
                                </ComboBox>

                                <TextBlock Text="Voz:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbQuickGender" Width="110" Margin="0,0,14,4" SelectionChanged="CmbQuickGender_SelectionChanged">
                                    <ComboBoxItem Content="👨 Hombre" Tag="male" />
                                    <ComboBoxItem Content="👩 Mujer" Tag="female" />
                                </ComboBox>

                                <TextBlock Text="Partida:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbCoachMode" Width="140" Margin="0,0,14,4">
                                    <ComboBoxItem Content="Automático" Tag="auto" />
                                    <ComboBoxItem Content="Competitiva" Tag="match" />
                                    <ComboBoxItem Content="Entrenamiento" Tag="training" />
                                </ComboBox>

                                <TextBlock Text="Modo IA:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbEngineType" Width="188" Margin="0,0,14,4" ToolTip="Live permite hablar en tiempo real (~0.9s); Turnos analiza jugadas cada pocos segundos">
                                    <ComboBoxItem Content="🎙 Live en Vivo (~0.9s)" Tag="live" />
                                    <ComboBoxItem Content="⚡ Turnos Automáticos" Tag="classic" />
                                </ComboBox>

                                <TextBlock Text="Pantalla:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,6,4" />
                                <ComboBox x:Name="CmbRunMode" Width="168" Margin="0,0,0,4" SelectedIndex="0" ToolTip="Auto-Detectar espera a que abras el juego; Modo Prueba analiza tu escritorio actual">
                                    <ComboBoxItem Content="Auto-Detectar Juego" Tag="auto" />
                                    <ComboBoxItem Content="Probar en Escritorio" Tag="test" />
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Gamer-Friendly Live Status Cards -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="JUEGO ACTIVO" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatActiveGame" Text="Esperando juego" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblAiCardTitle" Text="VELOCIDAD DE RESPUESTA" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatAiMs" Text="—" FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblVoiceCardTitle" Text="VOZ Y MICRÓFONO" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatVoiceMs" Text="Listo" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="10" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CONSEJOS EN PARTIDA" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                <TextBlock x:Name="StatInterventions" Text="0" FontSize="17" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Clean Gamer Coaching & Chat Feed -->
                    <Border Grid.Row="3" Background="#020617" CornerRadius="9" Padding="8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="4,0,4,6">
                                <TextBlock Text="💬 Consejos del Coach y Chat" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="🧹 Limpiar" Padding="9,2" FontSize="11" Click="BtnClearFeed_Click" />
                            </DockPanel>
                            <ListBox x:Name="LstCoachFeed"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CardBackgroundHex}"
                                                BorderBrush="#1E293B"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10,7"
                                                Margin="0,2,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding AccentHex}" CornerRadius="2" Margin="0,1,0,1" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Author}" Foreground="{Binding AuthorForegroundHex}" FontWeight="Bold" FontSize="11.5" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Message}" Foreground="#F1F5F9" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Collapsible Technical Console Drawer (for debugging / power users) -->
                    <Expander Grid.Row="4" Margin="0,8,0,0" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="🛠 Ver registro técnico (latencias, sensores y red)" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" />
                        </Expander.Header>
                        <Grid MaxHeight="140">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Claves API ocultas automáticamente · Clic derecho para copiar línea" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="🧹 Limpiar Logs" Padding="9,2" FontSize="11" Click="BtnClearLogs_Click" />
                            </DockPanel>
                            <ListBox x:Name="LstLiveLogs"
                                     Grid.Row="1"
                                     Background="#020617"
                                     BorderBrush="#1E293B"
                                     BorderThickness="1"
                                     Foreground="#94A3B8"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155">
                                        <MenuItem Header="📋 Copiar línea seleccionada" Click="MenuCopyLog_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#94A3B8" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Expander>

                    <!-- Interactive Text Chat + Post-Match Review Bar -->
                    <Border Grid.Row="5" Background="#0F172A" CornerRadius="8" Padding="8" Margin="0,8,0,0" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💬 Preguntale al coach:" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <TextBox x:Name="TxtChatInput"
                                     Grid.Column="1"
                                     Margin="0,0,8,0"
                                     IsEnabled="False"
                                     KeyDown="TxtChatInput_KeyDown"
                                     ToolTip="Escribí una pregunta mientras jugás (el coach ve tu pantalla actual) · Presioná Enter para enviar" />
                            <Button x:Name="BtnSendChat"
                                    Grid.Column="2"
                                    Content="Enviar ↵"
                                    Background="#0284C7"
                                    BorderBrush="#38BDF8"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="BtnSendChat_Click" />
                            <Button x:Name="BtnMatchReview"
                                    Grid.Column="3"
                                    Content="📊 Resumen Partida"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    ToolTip="Analiza tus errores de la última partida y te da 1 ejercicio práctico para la siguiente"
                                    Click="BtnMatchReview_Click" />
                            <Button x:Name="BtnOpenReviews"
                                    Grid.Column="4"
                                    Content="📂 Resúmenes"
                                    ToolTip="Abre la carpeta donde se guardan tus resúmenes post-partida"
                                    Click="BtnOpenReviews_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: AI PROVIDERS (SIMPLE FIRST, ADVANCED COLLAPSED) -->
            <TabItem Header="🤖 Proveedores IA ($0 Gratis)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Friendly Quick-Start Banner -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="11" Margin="0,0,0,10" BorderBrush="#0284C7" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button Content="🌐 Obtener clave Groq (Gratis)" Background="#059669" BorderBrush="#10B981" Click="BtnOpenGroq_Click" Margin="0,0,6,0" />
                                <Button Content="🌐 Obtener clave Gemini (Gratis)" Click="BtnOpenGemini_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚡ Conectá tu IA en 1 minuto (100% gratis con tu cuenta)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="Groq (~0.4s) y Google Gemini (con voz en vivo) tienen plan gratuito sin tarjeta. Copiá tu clave, elegí el servicio y pegala abajo." Foreground="#BAE6FD" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListView x:Name="LstAccounts" Grid.Row="1" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#1E293B" Margin="0,0,0,10" MouseDoubleClick="LstAccounts_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Orden" Width="48" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Nombre" Width="195" DisplayMemberBinding="{Binding Label}" />
                                <GridViewColumn Header="Servicio" Width="115" DisplayMemberBinding="{Binding ProviderDisplay}" />
                                <GridViewColumn Header="Capacidades" Width="95" DisplayMemberBinding="{Binding VisionDisplay}" />
                                <GridViewColumn Header="Clave" Width="125" DisplayMemberBinding="{Binding MaskedKeyDisplay}" />
                                <GridViewColumn Header="Activa" Width="60" DisplayMemberBinding="{Binding EnabledDisplay}" />
                                <GridViewColumn Header="Modelo" Width="190" DisplayMemberBinding="{Binding Model}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Stream-Safe Quick Connect Form -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="175" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Servicio de IA:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3" />
                                    <ComboBox x:Name="CmbNewProvider" DisplayMemberPath="FriendlyName" SelectedValuePath="Id" SelectionChanged="CmbNewProvider_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Nombre (ej: Mi Groq):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtNewLabel" Text="Groq LPU Gratis (~0.4s)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Tu Clave API (oculta si hacés stream en OBS/Discord):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3" />
                                    <PasswordBox x:Name="PwdNewApiKey" ToolTip="Pegá tu API Key (queda oculta con puntos para cuidar tu privacidad)" />
                                </StackPanel>
                                <Button x:Name="BtnAddAccount" Grid.Column="3" Content="+ Conectar IA" VerticalAlignment="Bottom" Background="#059669" BorderBrush="#10B981" Padding="14,6" Click="BtnAddAccount_Click" />
                                <Button x:Name="BtnCancelEdit" Grid.Column="4" Content="Cancelar" VerticalAlignment="Bottom" Visibility="Collapsed" Margin="6,0,0,0" Click="BtnCancelEdit_Click" />
                            </Grid>

                            <!-- Collapsible Advanced Options (hidden from casual players) -->
                            <Expander x:Name="ExpAccountAdvanced" Margin="0,10,0,0" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="⚙ Opciones avanzadas (modelo específico, servidor propio / Ollama, modo solo texto)" Foreground="#94A3B8" FontSize="11.5" />
                                </Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="175" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Modelo:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="TxtNewModel" Grid.Column="1" Margin="0,0,12,0" Text="meta-llama/llama-4-scout-17b-16e-instruct" />
                                    <TextBlock Grid.Column="2" Text="Servidor (opcional):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="TxtNewBaseUrl"
                                             Grid.Column="3"
                                             Margin="0,0,12,0"
                                             ToolTip="Solo si usás un servidor HTTPS propio o Ollama local (http://localhost:11434/v1). Dejar vacío para usar el oficial." />
                                    <TextBlock Grid.Column="4" Text="Modo:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="CmbNewVisionOverride"
                                              Grid.Column="5"
                                              SelectedIndex="0"
                                              ToolTip="Automático detecta si el modelo ve imágenes; Solo Texto usa lectura de pantalla + logs.">
                                        <ComboBoxItem Content="Automático" Tag="auto" />
                                        <ComboBoxItem Content="Con Visión (Imagen)" Tag="vision" />
                                        <ComboBoxItem Content="Solo Texto (OCR+Logs)" Tag="text" />
                                    </ComboBox>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="↑ Prioridad +" Click="BtnMoveUp_Click" Margin="0,0,6,0" />
                        <Button Content="↓ Prioridad -" Click="BtnMoveDown_Click" Margin="0,0,6,0" />
                        <Button x:Name="BtnEditAccount" Content="✏ Editar" Click="BtnEditAccount_Click" Margin="0,0,6,0" />
                        <Button Content="Activar / Pausar" Click="BtnToggleAccount_Click" Margin="0,0,6,0" />
                        <Button x:Name="BtnTestAccount" Content="🔍 Probar Conexión" Click="BtnTestAccount_Click" Margin="0,0,6,0" />
                        <Button Content="Eliminar" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteAccount_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: MY GAMES & PERSONAL COACHING RULES -->
            <TabItem Header="🎮 Mis Juegos">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Juego:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbRulesGame" Width="250" DisplayMemberPath="DisplayName" SelectedValuePath="GameId" SelectionChanged="CmbRulesGame_SelectionChanged" />
                        </StackPanel>
                        <TextBlock x:Name="LblRulesCount" DockPanel.Dock="Right" Text="0 / 600 caracteres" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Simple Add New Game Card (auto-generates internal ID, includes .exe browser!) -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="195" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="+ Agregar Juego" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Nombre:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtNewProfName" Grid.Column="2" Margin="0,0,10,0" ToolTip="Nombre del juego (ej: Apex Legends, Fortnite)" />
                            <TextBlock Grid.Column="3" Text="Archivo (.exe):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtNewProfExe" Grid.Column="4" Margin="0,0,6,0" ToolTip="Nombre del archivo del juego (ej: r5apex.exe) o usá 'Elegir .exe'" />
                            <Button x:Name="BtnBrowseNewExe" Grid.Column="5" Content="📂 Elegir .exe" Margin="0,0,8,0" Click="BtnBrowseNewExe_Click" ToolTip="Buscá el .exe del juego en tu PC sin tener que escribirlo" />
                            <Button x:Name="BtnCreateProfile" Grid.Column="6" Content="➕ Agregar" Background="#059669" BorderBrush="#10B981" Click="BtnCreateProfile_Click" />
                        </Grid>
                    </Border>

                    <!-- Starter Idea Chips -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="📝 Indicaciones personales para el coach en este juego (opcional):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <TextBlock Text="Ideas rápidas:" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <Button Style="{StaticResource ChipButton}" Content="+ Sé breve, solo jugadas clave" Tag="Sé breve y directo: avisame solo en jugadas clave." Margin="0,0,6,4" Click="BtnPromptChip_Click" />
                            <Button Style="{StaticResource ChipButton}" Content="+ Controlar recursos / boost" Tag="Avisame cuando esté bajo de recursos, vida o boost." Margin="0,0,6,4" Click="BtnPromptChip_Click" />
                            <Button Style="{StaticResource ChipButton}" Content="+ Cuidar posicionamiento" Tag="Recordame cuidar el posicionamiento y no regalar ventaja." Margin="0,0,0,4" Click="BtnPromptChip_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBox x:Name="TxtCustomRules"
                             Grid.Row="3"
                             MaxLength="600"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Padding="10"
                             TextChanged="TxtCustomRules_TextChanged" />

                    <!-- Collapsible Technical Detection Drawer -->
                    <Expander Grid.Row="4" Margin="0,8,0,0" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="⚙ Ajustes avanzados de detección (archivos .exe, frecuencia y sensibilidad)" Foreground="#94A3B8" FontSize="11.5" />
                        </Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Archivos .exe:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtProfileExes" Grid.Column="1" Margin="0,0,12,0" ToolTip="Ejecutables del juego separados por coma" />
                            <TextBlock Grid.Column="2" Text="Pausa entre avisos (seg):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtProfileCooldown" Grid.Column="3" Margin="0,0,12,0" ToolTip="Segundos mínimos entre consejos automáticos (1 a 120)" />
                            <TextBlock Grid.Column="4" Text="Sensibilidad visual (1–64):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtProfilePhash" Grid.Column="5" ToolTip="Menor número = reacciona ante cambios más chicos en pantalla (recomendado: 6 a 10)" />
                        </Grid>
                    </Expander>

                    <DockPanel Grid.Row="5" Margin="0,10,0,0">
                        <Button x:Name="BtnDeleteProfile" DockPanel.Dock="Left" Content="🗑 Eliminar Juego" Background="#7F1D1D" BorderBrush="#EF4444" Click="BtnDeleteProfile_Click" />
                        <Button Content="💾 Guardar Indicaciones" HorizontalAlignment="Right" Background="#0284C7" BorderBrush="#38BDF8" Padding="14,6" Click="BtnSaveRules_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: GROUPED GAMER-FRIENDLY SETTINGS -->
            <TabItem Header="⚙ Ajustes y Voz">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                            <!-- Card 1: Player Profile & Coach Style -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🎯 Tu Nivel y Estilo del Coach" Foreground="#38BDF8" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="360" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tu Nivel de Juego:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbSkillTier" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🌱 Principiante (fundamentos simples y paciencia)" Tag="beginner" />
                                            <ComboBoxItem Content="🥉 Casual (Bronce–Plata / Hierro–Bronce)" Tag="casual" />
                                            <ComboBoxItem Content="🥈 Intermedio (Oro–Platino / Plata–Oro)" Tag="intermediate" />
                                            <ComboBoxItem Content="🥇 Avanzado (Diamante–Campeón / Ascendente)" Tag="advanced" />
                                            <ComboBoxItem Content="🏆 Competitivo / Pro (GC–SSL / Radiant / Faceit 10)" Tag="pro" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tu Rango exacto (opcional):" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtRankLabel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: Platino 2 en 2v2, Diamante 1, Oro 3..." />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Personalidad del Coach:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbCoachStyle" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🤝 Amigable y motivador (celebra aciertos)" Tag="friendly" />
                                            <ComboBoxItem Content="🎯 Directo y táctico (al punto)" Tag="tactical" />
                                            <ComboBoxItem Content="🔥 Exigente estilo torneo (sin filtro)" Tag="strict" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Idioma del Coach:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbLanguage" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🇪🇸 Español" Tag="es" />
                                            <ComboBoxItem Content="🇺🇸 English" Tag="en" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Frecuencia en modo Live:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbLiveAutoRate" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🎙 Solo cuando le hablo o toco F10 (sin interrumpir)" Tag="0" />
                                            <ComboBoxItem Content="⚖ Equilibrado (cada 12s en jugada real)" Tag="12" />
                                            <ComboBoxItem Content="⚡ Activo (cada 8s en jugada real)" Tag="8" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Velocidad vs Nitidez visual:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbEfficiency" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" ToolTip="Rápido consume menos datos y responde antes; Máxima nitidez lee textos muy chicos del HUD">
                                            <ComboBoxItem Content="⚡ Rápido (menor consumo · recomendado)" Tag="eco" />
                                            <ComboBoxItem Content="⚖ Equilibrado (HD)" Tag="balanced" />
                                            <ComboBoxItem Content="💎 Máxima nitidez (Full HD)" Tag="high" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Voice, Mic & Audio -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="🎙 Voz, Micrófono y Sonido" Foreground="#10B981" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                        <Button x:Name="BtnTestMic" DockPanel.Dock="Right" Content="🎤 Probar Micrófono" Padding="10,4" Click="BtnTestMic_Click" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo de Comunicación:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbCommModeSettings" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbCommModeSettings_SelectionChanged">
                                            <ComboBoxItem Content="🎙 Charla (Micrófono + Voz del coach)" Tag="conversation" />
                                            <ComboBoxItem Content="🔊 Solo voz del coach (mic apagado)" Tag="coach_voice" />
                                            <ComboBoxItem Content="💬 Solo texto (100% silencioso)" Tag="text_only" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Voz del Coach:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbVoiceGender" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                                            <ComboBoxItem Content="👨 Hombre (Fenrir / Tomás)" Tag="male" />
                                            <ComboBoxItem Content="👩 Mujer (Aoede / Elena)" Tag="female" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Calidad de Voz (Turnos):" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbVoiceStyle" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="CmbVoiceSettings_SelectionChanged">
                                            <ComboBoxItem Content="🎙 Voz Natural Windows (recomendada)" Tag="neural" />
                                            <ComboBoxItem Content="⚡ Instantánea ultra-rápida (~8ms)" Tag="instant" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Uso del Micrófono (Live):" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbMicInputMode" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🎙 Mic Abierto (hablás cuando querés)" Tag="open_mic" />
                                            <ComboBoxItem Content="⌨ Push-to-Talk (mantener tecla para hablar)" Tag="push_to_talk" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tecla Push-to-Talk:" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtPttKey" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: V, Alt, CapsLock, Space, Mouse4, Mouse5" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Micrófono:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbMicDevice" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Auriculares / Parlantes:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbSpeakerDevice" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Volumen de Voz:" VerticalAlignment="Center" />
                                        <Slider x:Name="SldVolume" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged" />
                                        <TextBlock x:Name="LblVolumePct" Grid.Row="7" Grid.Column="2" Text="75%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                    <CheckBox x:Name="ChkEnableAudioCues" Content="Sonidos suaves de confirmación (al pausar, mutear mic o pulsar Push-to-Talk)" Margin="0,6,0,0" ToolTip="Emite un tono sutil al usar atajos (silenciado en modo Solo Texto)." />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Floating Overlay on Game -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="💬 Cartel Flotante sobre el Juego (Overlay)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="👁 Probar Cartel + Voz" Padding="10,4" Click="BtnPreviewOverlay_Click" />
                                    </DockPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox x:Name="ChkEnableOverlay" Content="Mostrar cartel sobre el juego (no molesta el mouse)" Margin="0,0,20,6" />
                                        <CheckBox x:Name="ChkOverlayCompact" Content="Estilo compacto (más discreto)" Margin="0,0,0,6" />
                                    </WrapPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Posición en Pantalla:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbOverlayPos" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBoxItem Content="↗ Arriba a la derecha" Tag="top-right" />
                                            <ComboBoxItem Content="↖ Arriba a la izquierda" Tag="top-left" />
                                            <ComboBoxItem Content="⬆ Arriba al centro" Tag="top-center" />
                                            <ComboBoxItem Content="↘ Abajo a la derecha" Tag="bottom-right" />
                                            <ComboBoxItem Content="↙ Abajo a la izquierda" Tag="bottom-left" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pantalla / Monitor:" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CmbMonitor" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Index" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tamaño del Cartel:" VerticalAlignment="Center" />
                                        <Slider x:Name="SldOverlayScale" Grid.Row="2" Grid.Column="1" Minimum="0.75" Maximum="1.45" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                                        <TextBlock x:Name="LblOverlayScale" Grid.Row="2" Grid.Column="2" Text="100%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Transparencia / Opacidad:" VerticalAlignment="Center" />
                                        <Slider x:Name="SldOverlayOpacity" Grid.Row="3" Grid.Column="1" Minimum="0.45" Maximum="1.0" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="SldOverlayVisual_ValueChanged" />
                                        <TextBlock x:Name="LblOverlayOpacity" Grid.Row="3" Grid.Column="2" Text="90%" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Hotkeys, Game Integration & Updates -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="⌨ Teclas Rápidas y Sistema" Foreground="#F59E0B" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox x:Name="ChkEnableHotkeys" Content="Activar teclas rápidas dentro del juego" Margin="0,0,20,6" />
                                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimizar junto al reloj (Bandeja)" Margin="0,0,20,6" />
                                        <CheckBox x:Name="ChkCheckUpdatesOnStartup" Content="Avisar nuevas versiones disponibles" Margin="0,0,0,6" ToolTip="Busca actualizaciones en GitHub Releases al abrir y cada 60 min en reposo." />
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="360" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tecla Pausar / Reanudar:" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtPauseKey" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tecla Analizar Ahora:" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtAnalyzeKey" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tecla Silenciar Micrófono:" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtMicKey" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ToolTip="Ej: F8, Ctrl+M" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="🎮 Activar conexión CS2 / Dota 2" Click="BtnInstallGsi_Click" Margin="0,0,10,4" ToolTip="Instala el archivo oficial de lectura de partida en Steam (100% seguro, sin tocar memoria)" />
                                        <Button x:Name="BtnCheckUpdates" Content="🔄 Buscar Actualizaciones" Click="BtnCheckUpdates_Click" Margin="0,0,0,4" ToolTip="Verifica si salió una nueva versión en GitHub Releases" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sticky Save Bar -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,8,0,0" BorderBrush="#1E293B" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="Los cambios de volumen, cartel y voz se aplican en tiempo real al guardar." Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="💾 Guardar y Aplicar Cambios" Background="#0284C7" BorderBrush="#38BDF8" Padding="16,7" Click="BtnSaveConfig_Click" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
