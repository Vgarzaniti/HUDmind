# =============================================================================
# HUDMind - Configuración de Entorno
# Copia este archivo a ".env" y completa tu API Key de Google AI Studio.
# NUNCA subas el archivo ".env" a control de versiones.
# =============================================================================

# --- Credenciales Gemini API (Obligatorio salvo en --dry-run) ---
GEMINI_API_KEY=your_api_key_here

# --- Modelo y Context Caching ---
# Opciones recomendadas: gemini-2.5-flash | gemini-2.5-flash-lite
DEFAULT_MODEL=gemini-2.5-flash
CACHE_TTL_SECONDS=3600
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_TEMPERATURE=0.2
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# --- Salidas y Controles (Voz, Overlay y Hotkeys Windows) ---
ENABLE_VOICE=true
ENABLE_OVERLAY=true
# Hotkeys nativos Win32 sin hooks intrusivos: F9 = Pausar/Reanudar | F10 = Pedir consejo ahora
ENABLE_HOTKEYS=true

# Motor TTS: "edge" (online, alta calidad) | "pyttsx3" (offline, baja latencia) | "piper" (local neural)
TTS_ENGINE=edge
# Voz para edge-tts (ej. es-AR-TomasNeural, es-ES-AlvaroNeural, es-MX-JorgeNeural, en-US-ChristopherNeural)
TTS_VOICE=es-AR-TomasNeural
TTS_RATE=+10%
TTS_VOLUME=0.9

# Configuración del Overlay transparente (Windows click-through)
OVERLAY_DURATION_SECONDS=6.0
OVERLAY_POSITION=top-right
OVERLAY_WIDTH=440
OVERLAY_OPACITY=0.90

# --- Captura y Rendimiento ---
# Monitor a capturar (1 = monitor principal en MSS, 0 = todos combinados)
CAPTURE_MONITOR=1
# Intervalo mínimo en segundos entre peticiones a Gemini (protección anti-spam de API)
MIN_INFERENCE_INTERVAL_SECONDS=2.5
# Formato y calidad de compresión en memoria ("jpeg" = mínimo CPU ~2ms | "webp" = menor ancho de banda)
IMAGE_FORMAT=jpeg
IMAGE_COMPRESSION_QUALITY=78
# Ahorro de tokens: "eco" (540p, ~45% menos tokens) | "balanced" (720p) | "high"
TOKEN_EFFICIENCY_MODE=balanced
# Prioridad Windows BELOW_NORMAL para proteger al 100% los FPS del juego
LOW_PROCESS_PRIORITY=true

# --- Directorios y Logging ---
PROFILES_DIR=profiles
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=false
LOG_FILE=logs/copilot.log
PROCESS_POLL_INTERVAL_SECONDS=2.0
